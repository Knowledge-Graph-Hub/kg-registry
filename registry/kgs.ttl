        kgr:eol-traitbank.reconciliation,
        kgr:eol-traitbank.web ;
    schema1:identifier "eol-traitbank" ;
    schema1:name "Encyclopedia of Life (EOL) TraitBank" ;
    doap:repository <https://github.com/EOL> ;
    skos:inScheme "organisms",
        "phenotype" ;
    adms:status "Active" ;
    foaf:homepage <https://eol.org/traitbank> ;
    foaf:maker kgr:smithsonian-nmnh .

kgr:epa-aqs a schema1:DataSource ;
    rdfs:label "EPA Air Quality System (AQS)" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Air Quality System (AQS) is the US Environmental Protection Agency's repository of ambient air-quality monitoring data, assembled to support air quality assessments, area designations, modeling for permit review, and reports to Congress mandated by the Clean Air Act. It holds pollutant measurements from thousands of monitoring stations operated by EPA, state, local, and tribal agencies, along with meteorological data, station location information, and quality-assurance records. AQS data are exposed programmatically through a public REST API that returns JSON. AQS is an upstream data source for the KnowWhereGraph." ;
    dcterms:identifier "epa-aqs" ;
    dcterms:license "US federal government public domain" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:epa-aqs.api,
        kgr:epa-aqs.landing,
        kgr:knowwheregraph.graph ;
    schema1:name "EPA Air Quality System (AQS)" ;
    skos:inScheme "environment",
        "public health" ;
    adms:status "Active" ;
    foaf:homepage <https://www.epa.gov/aqs> .

kgr:epa-echo a schema1:DataSource ;
    rdfs:label "EPA Enforcement and Compliance History Online (ECHO)" ;
    dcterms:created "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "EPA Enforcement and Compliance History Online (ECHO) is a US Environmental Protection Agency web resource that provides access to compliance and enforcement information for regulated facilities, along with integrated environmental data downloads. ECHO hosts the PFAS Analytic Tools, which aggregate per- and polyfluoroalkyl substance (PFAS) information from multiple EPA programs, including drinking water sampling, clean water discharge monitoring, facility registry records, and greenhouse gas reporting, into downloadable, filterable datasets. SAWGraph obtains several of its federal PFAS datasets through the ECHO PFAS Analytic Tools download interface." ;
    dcterms:identifier "epa-echo" ;
    dcterms:license "US federal government public domain" ;
    dcterms:modified "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:epa-echo.landing,
        kgr:epa-echo.pfas-tools,
        kgr:sawgraph.graph ;
    schema1:name "EPA Enforcement and Compliance History Online (ECHO)" ;
    skos:inScheme "chemistry and biochemistry",
        "environment",
        "public health" ;
    adms:status "Active" ;
    foaf:homepage <https://echo.epa.gov/> .

kgr:epa-frs a schema1:DataSource ;
    rdfs:label "EPA Facility Registry Service (FRS)" ;
    dcterms:created "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Facility Registry Service (FRS) is the US Environmental Protection Agency's centrally managed database that identifies facilities, sites, and places subject to environmental regulation or of environmental interest. Each facility is assigned a unique FRS identifier and described with location, industry classification (NAICS and SIC codes), and links to EPA program records. SAWGraph uses FRS as a primary source for the facilities associated with PFAS releases and for their industry classifications, integrated through the SAWGraph Facilities and Industries Ontology (FIO)." ;
    dcterms:identifier "epa-frs" ;
    dcterms:license "US federal government public domain" ;
    dcterms:modified "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:epa-frs.data,
        kgr:epa-frs.landing,
        kgr:fiokg.graph,
        kgr:sawgraph.graph ;
    schema1:name "EPA Facility Registry Service (FRS)" ;
    skos:inScheme "environment",
        "general" ;
    adms:status "Active" ;
    foaf:homepage <https://www.epa.gov/frs> .

kgr:epa-ghg a schema1:DataSource ;
    rdfs:label "EPA Greenhouse Gas Reporting Program (GHGRP)" ;
    dcterms:created "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The US Environmental Protection Agency's Greenhouse Gas Reporting Program (GHGRP) collects annual greenhouse gas data from large emitting facilities, suppliers, and other sources across the United States. It includes fluorinated greenhouse gas emissions and supplies, some of which involve per- and polyfluoroalkyl substances (PFAS) and related fluorinated chemistry, reported by facility with location, chemical identity, and emission amounts. SAWGraph uses GHGRP facility emission data, obtained through the EPA PFAS Analytic Tools, as a primary source for PFAS-related releases from industrial facilities." ;
    dcterms:identifier "epa-ghg" ;
    dcterms:license "US federal government public domain" ;
    dcterms:modified "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:epa-ghg.fgas,
        kgr:epa-ghg.landing,
        kgr:sawgraph.graph ;
    schema1:name "EPA Greenhouse Gas Reporting Program (GHGRP)" ;
    skos:inScheme "chemistry and biochemistry",
        "environment" ;
    adms:status "Active" ;
    foaf:homepage <https://www.epa.gov/ghgreporting> .

kgr:epa-sdwis a schema1:DataSource ;
    rdfs:label "EPA Safe Drinking Water Information System (SDWIS)" ;
    dcterms:created "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Safe Drinking Water Information System (SDWIS) is the US Environmental Protection Agency's national database of public water system information collected under the Safe Drinking Water Act. It records public water systems, their sampling points, monitoring results, and violations, including per- and polyfluoroalkyl substance (PFAS) sampling reported by states and EPA. SDWIS PFAS results are distributed through the EPA PFAS Analytic Tools and SDWIS Federal Reports interfaces. SAWGraph uses SDWIS drinking water PFAS data as a primary source for PFAS occurrence in public water systems." ;
    dcterms:identifier "epa-sdwis" ;
    dcterms:license "US federal government public domain" ;
    dcterms:modified "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
