kgr:regl a schema1:DataSource ;
    rdfs:label "Richards Effector Gene List" ;
    dcterms:created "2026-02-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Richards Effector Gene List (REGL) provides the results of the Effector Index (Ei), a machine-learning method that prioritizes the likely causal (effector) target genes at genome-wide association study (GWAS) loci. Developed by the Richards Lab at McGill University, the Ei was trained and validated against positive-control gene sets derived from Mendelian disease genes and approved drug targets across 12 common diseases and quantitative traits, using genomic features such as coding or transcript-altering variants, distance to gene, and open-chromatin-based metrics. It is integrated into the NCATS Biomedical Data Translator as a source for linking genetic association signals to their probable effector genes." ;
    dcterms:identifier "regl" ;
    dcterms:isReferencedBy <https://www.ncbi.nlm.nih.gov/pubmed/35147782> ;
    dcterms:modified "2026-07-02T00:00:00+00:00"^^xsd:dateTime ;
    schema1:about <NCBITaxon:9606> ;
    schema1:hasPart kgr:regl.docs ;
    schema1:identifier "regl" ;
    schema1:name "Richards Effector Gene List" ;
    skos:inScheme "biomedical",
        "drug discovery",
        "genomics" ;
    adms:status "Active" ;
    foaf:homepage <https://github.com/NCATSTranslator/Translator-All/wiki/Richards-Effector-Gene-List> ;
    foaf:maker kgr:mcgill-genepi .

kgr:reliefweb a schema1:DataSource ;
    rdfs:label "ReliefWeb" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "ReliefWeb is the humanitarian information service operated by the United Nations Office for the Coordination of Humanitarian Affairs (UN OCHA). It aggregates situation reports, disaster and crisis updates, maps, infographics, and humanitarian job and training announcements from thousands of trusted sources worldwide. Its content is openly accessible through the ReliefWeb website and a public REST API covering reports, disasters, jobs, and training records. ReliefWeb is an upstream data source for the KnowWhereGraph project." ;
    dcterms:identifier "reliefweb" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:knowwheregraph.graph,
        kgr:reliefweb.api,
        kgr:reliefweb.site ;
    schema1:name "ReliefWeb" ;
    skos:inScheme "environment",
        "general",
        "public health" ;
    adms:status "Active" ;
    foaf:homepage <https://reliefweb.int/> .

kgr:remap a schema1:DataSource ;
    rdfs:label "ReMap" ;
    dcterms:created "2026-05-21T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "ReMap is a curated regulatory genomics resource that integrates public DNA-binding sequencing experiments to produce high-quality catalogs of transcriptional regulator binding regions across human, mouse, Drosophila, and Arabidopsis." ;
    dcterms:identifier "remap" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/nar/gkab996> ;
