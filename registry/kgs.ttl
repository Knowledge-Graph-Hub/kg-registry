kgr:ncipidkg a schema1:KnowledgeGraph ;
    rdfs:label "NCI-PID 2.0 KG" ;
    dcterms:created "2026-03-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The NCI-PID 2.0 Knowledge Graph converts NCI Pathway Interaction Database version 2.0 networks into RDF, capturing protein interactions, signaling pathways, and post-translational modifications enriched with INDRA evidence metadata." ;
