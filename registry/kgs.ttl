        kgr:patric.genomes,
        kgr:patric.web ;
    schema1:identifier "patric" ;
    schema1:name "Pathosystems Resource Integration Center" ;
    skos:altLabel "BV-BRC",
        "Bacterial and Viral Bioinformatics Resource Center",
        "PATRIC" ;
    skos:inScheme "biomedical",
        "genomics",
        "microbiology" ;
    adms:status "Inactive" ;
    foaf:homepage <https://www.bv-brc.org/> .

kgr:paxdb a schema1:DataSource ;
    rdfs:label "PaxDb" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "PaxDb (Protein Abundance Database) is a database of whole-organism protein abundance information across organisms. It integrates and re-processes quantitative proteomics datasets to provide consistent, comparable protein abundance estimates for thousands of proteins in many species." ;
    dcterms:identifier "paxdb" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/nar/gkaf1066> ;
