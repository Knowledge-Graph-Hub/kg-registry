        kgr:epigraphdb.examples,
        kgr:epigraphdb.graph,
        kgr:epigraphdb.rpackage,
        kgr:epigraphdb.web ;
    schema1:name "EpiGraphDB" ;
    doap:repository <https://github.com/MRCIEU/epigraphdb> ;
    skos:inScheme "biomedical",
        "general",
        "genomics" ;
    adms:status "Active" ;
    foaf:homepage <https://epigraphdb.org/> .

