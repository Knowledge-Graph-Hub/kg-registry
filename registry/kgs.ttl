kgr:hocomoco a schema1:DataSource ;
    rdfs:label "HOCOMOCO" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "HOCOMOCO (HOmo sapiens COmprehensive MOdel COllection) is a curated database of transcription factor (TF) binding models, primarily position weight matrices (PWMs), for human and mouse. The models are derived from large-scale ChIP-Seq and HT-SELEX experiments and are manually curated, benchmarked, and annotated with quality ratings and recommended score thresholds. HOCOMOCO covers over a thousand human and mouse TFs, including secondary motif subtypes, and is a widely used upstream source for downstream regulatory resources such as DoRothEA." ;
    dcterms:identifier "hocomoco" ;
    dcterms:isReferencedBy <https://www.ncbi.nlm.nih.gov/pubmed/29140464> ;
    dcterms:license <http://www.wtfpl.net/> ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:dorothea.graph,
        kgr:hocomoco.core-pwms,
        kgr:hocomoco.downloads,
        kgr:hocomoco.full-pwms ;
    schema1:name "HOCOMOCO" ;
    skos:inScheme "genomics",
        "proteomics",
        "systems biology" ;
    adms:status "Active" ;
    foaf:homepage <https://hocomoco.autosome.org> .

