kgr:aop-db.sparql a schema1:ProgrammingInterface ;
    rdfs:label "AOP-DB SPARQL Endpoint" ;
    dcterms:description "Public Virtuoso SPARQL endpoint loaded with RDF of the EPA AOP-DB for querying integrated AOP, gene, chemical, disease, tissue, pathway, orthology, ontology, and gene interaction relationships. Originally deployed under the OpenRiskNet project and now hosted by the BiGCaT department at Maastricht University." ;
    schema1:url <https://aopdb.rdf.bigcat-bioinformatics.org/sparql/> .

kgr:aopwiki-rdf.converter a schema1:ProcessProduct ;
    rdfs:label "AOP-Wiki XML to RDF Conversion Tool" ;
    dcterms:description "Python conversion pipeline that transforms the AOP-Wiki XML export into RDF/Turtle, performs the three-stage gene-mapping algorithm, and runs Turtle syntax and URI-resolvability quality control. Executed weekly by GitHub Actions (Saturdays 08:00 UTC). Code is MIT licensed." ;
    schema1:url <https://github.com/marvinm2/AOPWikiRDF> .

kgr:aopwiki-rdf.dashboard a schema1:GraphicalInterface ;
    rdfs:label "AOP-Wiki RDF Dashboard" ;
    dcterms:description "Web dashboard visualizing the content and growth of AOP-Wiki RDF across all quarterly versions, with entity counts, key event component and ontology usage breakdowns, network statistics, completeness metrics and an interactive AOP network view. Every plot exposes the SPARQL query behind it and offers CSV export." ;
    schema1:url <https://aopwiki-dashboard.vhp4safety.nl> .

kgr:aopwiki-rdf.grlc-api a schema1:ProgrammingInterface ;
    rdfs:label "AOP-Wiki RDF grlc REST API" ;
    dcterms:description "grlc-generated REST API that exposes the curated AOP-Wiki SPARQL example queries as parameterized HTTP endpoints with a Swagger/OpenAPI description, for users who prefer REST over writing SPARQL." ;
    schema1:url <https://aopwiki.api.bigcat-bioinformatics.org/> .

kgr:aopwiki-rdf.multiversion-sparql a schema1:ProgrammingInterface ;
    rdfs:label "AOP-Wiki RDF Multi-Version SPARQL Endpoint" ;
    dcterms:description "Companion SPARQL endpoint holding every quarterly AOP-Wiki snapshot from 2018-04-01 onwards as separate named graphs (http://aopwiki.org/graph/YYYY-MM-DD), 33 versions at present, for tracking how AOP-Wiki content evolves over time." ;
    schema1:url <https://aopwiki-multirdf.vhp4safety.nl/sparql> .

kgr:aopwiki-rdf.queries a schema1:DocumentationProduct ;
    rdfs:label "AOP-Wiki SPARQL Query Library" ;
    dcterms:description "Curated library of documented SPARQL example queries for AOP-Wiki RDF, organised by category (metadata, AOPs, key events, KERs, stressors, chemicals, data export, federated queries). Consumed by both the SNORQL interface and the grlc REST API." ;
    schema1:url <https://github.com/marvinm2/AOP-Wiki-Queries> .

kgr:aopwiki-rdf.snorql a schema1:GraphicalInterface ;
    rdfs:label "AOP-Wiki RDF SNORQL Interface" ;
    dcterms:description "SNORQL web interface (\"AOP-Wiki RDF Explorer\") for interactive SPARQL querying of the AOP-Wiki RDF endpoint. Provides a CodeMirror SPARQL editor with syntax highlighting, a browsable library of curated and parameterized example queries, endpoint health indication, result browsing with dereferenceable URIs, and CSV/JSON/XML export." ;
    schema1:url <https://aopwiki.rdf.bigcat-bioinformatics.org/> .

kgr:aopwiki-rdf.sparql a schema1:ProgrammingInterface ;
    rdfs:label "AOP-Wiki RDF SPARQL Endpoint" ;
    dcterms:description "Public SPARQL 1.1 endpoint (Virtuoso 7.2.11) serving the AOP-Wiki RDF graph, including the gene-mapping and cross-reference enrichments. Supports SELECT, CONSTRUCT, ASK and DESCRIBE over HTTP GET/POST with JSON, XML, CSV and Turtle result serializations, and federated queries via SERVICE. Reloaded weekly from the generated Turtle files." ;
    schema1:url <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> .

