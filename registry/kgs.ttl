kgr:treatkb a schema1:DataSource ;
    rdfs:label "TreatKB" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "TreatKB is a text-mined knowledge base of drug-treats-disease (treatment) relationships developed by the Rong Xu lab at Case Western Reserve University. Treatment pairs are extracted and combined from multiple lines of evidence, including MEDLINE/PubMed literature, the FDA Adverse Event Reporting System (FAERS), and ClinicalTrials.gov records, alongside a curated gold-standard set of drug-disease treatment pairs. The data are distributed as plain-text files from the Xu lab public data server. TreatKB has been used as a source to construct GP-KG." ;
    dcterms:identifier "treatkb" ;
    dcterms:isReferencedBy <doi:10.1186/1471-2105-14-181> ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-07-02T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:gp-kg.graph,
        kgr:treatkb.goldstandard,
        kgr:treatkb.publication ;
    schema1:name "TreatKB" ;
    skos:inScheme "clinical",
        "drug discovery",
        "literature",
        "pharmacology" ;
    adms:status "Active" ;
    foaf:homepage <http://nlp.case.edu/public/data/treatKB/> .

kgr:tred a schema1:DataSource ;
    rdfs:label "Transcriptional Regulatory Element Database" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "TRED (Transcriptional Regulatory Element Database) was a curated database of cis-regulatory elements, with an emphasis on transcription factor (TF) binding sites, TF-promoter regulatory interactions, and promoter annotations for human, mouse, and rat genes. It combined computational promoter prediction with literature-based manual curation of regulatory interactions, and was originally developed and hosted at Cold Spring Harbor Laboratory. TRED served as an upstream primary source for downstream regulatory network resources such as DoRothEA. The resource is now legacy and effectively superseded; its original hosting sites are no longer serving content, and it was dropped from some downstream tools due to licensing constraints." ;
    dcterms:identifier "tred" ;
    dcterms:isReferencedBy <https://pubmed.ncbi.nlm.nih.gov/17202159/> ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:dorothea.graph,
        kgr:tred.docs ;
    schema1:name "Transcriptional Regulatory Element Database" ;
    skos:inScheme "biological systems",
        "genomics",
        "systems biology" ;
    adms:status "Inactive" ;
    foaf:homepage <https://rulai.cshl.edu/TRED/> .

kgr:treefam a schema1:DataSource ;
    rdfs:label "TreeFam" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "TreeFam (Tree families database) is a database of phylogenetic trees of animal gene families. It provides curated and automatically generated gene trees, inferred orthologs and paralogs, and gene family annotations across a wide range of animal species." ;
    dcterms:identifier "treefam" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/nar/gkt1055> ;
    dcterms:modified "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:genecards.web.interface,
        kgr:treefam.downloads,
        kgr:treefam.site ;
    schema1:name "TreeFam" ;
    skos:inScheme "genomics",
        "organisms" ;
    adms:status "Active" ;
    foaf:homepage <http://www.treefam.org/> .

kgr:trrust a schema1:DataSource ;
    rdfs:label "TRRUST" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "TRRUST (Transcriptional Regulatory Relationships Unraveled by Sentence-based Text mining) is a manually curated database of human and mouse transcriptional regulatory networks. Its interactions are extracted from sentences in PubMed abstracts using sentence-based text mining followed by manual expert curation, capturing transcription factor (TF) to target-gene relationships along with the mode of regulation (activation, repression, or unknown). The v2 release contains 8,444 human and 6,552 mouse TF-target regulatory interactions derived from over 11,000 PubMed articles, each linked to the supporting literature evidence. TRRUST serves as an upstream primary source for derived regulatory-network resources such as DoRothEA." ;
    dcterms:identifier "trrust" ;
    dcterms:isReferencedBy <https://www.ncbi.nlm.nih.gov/pubmed/29087512> ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:dorothea.graph,
        kgr:trrust.human.tsv,
        kgr:trrust.mouse.tsv,
        kgr:trrust.web ;
    schema1:name "TRRUST" ;
    skos:inScheme "biological systems",
        "genomics",
        "systems biology" ;
    adms:status "Active" ;
    foaf:homepage <https://www.grnpedia.org/trrust/> .

