    rdfs:label "ADReCS" ;
    dcterms:created "2026-05-29T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "ADReCS is a database of adverse drug reaction terms and drug-side effect relationships used for pharmacovigilance and drug safety analysis." ;
