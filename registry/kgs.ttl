kgr:ohdsi a schema1:Aggregator,
        "Organization" ;
    rdfs:label "OHDSI" ;
    dcterms:created "2026-04-10T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "Observational Health Data Sciences and Informatics (OHDSI) is an open, international collaborative that develops and maintains the OMOP Common Data Model, standardized clinical vocabularies, and open-source analytics tooling for observational health research. In KG-Registry, this entry represents the parent OHDSI ecosystem that publishes OMOP specifications and distributes standardized vocabulary access through Athena." ;
    dcterms:identifier "ohdsi" ;
    dcterms:modified "2026-06-02T00:00:00+00:00"^^xsd:dateTime ;
    schema1:about <NCBITaxon:9606> ;
    schema1:hasPart kgr:ohdsi.achilles,
        kgr:ohdsi.ares,
        kgr:ohdsi.athena,
        kgr:ohdsi.athena_vocabularies,
        kgr:ohdsi.atlas,
        kgr:ohdsi.cdm_r_package,
        kgr:ohdsi.cohort_diagnostics,
        kgr:ohdsi.data_quality_dashboard,
        kgr:ohdsi.feature_extraction,
        kgr:ohdsi.hades,
        kgr:ohdsi.omop_cdm,
        kgr:ohdsi.portal,
        kgr:ohdsi.rabbit_in_a_hat ;
    schema1:name "OHDSI" ;
    skos:altLabel "Observational Health Data Sciences and Informatics" ;
    skos:inScheme "biomedical",
        "clinical",
        "information technology" ;
    adms:status "Active" ;
    foaf:homepage <https://www.ohdsi.org/> ;
    foaf:maker kgr:ohdsi .

kgr:ohdsi.achilles a schema1:ProcessProduct ;
    rdfs:label "Achilles" ;
    dcterms:description "Package for broad database characterization against an OMOP CDM instance" ;
    schema1:url <https://github.com/OHDSI/Achilles> .

kgr:ohdsi.ares a schema1:ProcessProduct ;
    rdfs:label "ARES" ;
    dcterms:description "Application for displaying results from Achilles and Data Quality Dashboard to support data quality and characterization research" ;
    schema1:url <https://github.com/OHDSI/Ares> .

kgr:ohdsi.atlas a schema1:ProcessProduct ;
    rdfs:label "ATLAS" ;
    dcterms:description "Open-source software for conducting scientific analyses on standardized observational data" ;
    schema1:url <https://atlas-demo.ohdsi.org/> .

kgr:ohdsi.cdm_r_package a schema1:ProcessProduct ;
    rdfs:label "CDM R Package" ;
    dcterms:description "R package used to dynamically generate OMOP CDM documentation and DDL scripts for supported SQL dialects" ;
    schema1:url <https://github.com/OHDSI/CommonDataModel/> .

kgr:ohdsi.cohort_diagnostics a schema1:ProcessProduct ;
    rdfs:label "Cohort Diagnostics" ;
    dcterms:description "Package for evaluating and diagnosing cohort phenotype definitions built on OMOP CDM data" ;
    schema1:url <https://github.com/OHDSI/CohortDiagnostics> .

kgr:ohdsi.data_quality_dashboard a schema1:ProcessProduct ;
    rdfs:label "Data Quality Dashboard" ;
    dcterms:description "Tool that runs more than 3,500 data quality checks against an OMOP CDM instance" ;
    schema1:url <https://github.com/OHDSI/DataQualityDashboard> .

kgr:ohdsi.feature_extraction a schema1:ProcessProduct ;
    rdfs:label "Feature Extraction" ;
    dcterms:description "Package for generating cohort covariates and other features from OMOP CDM data" ;
    schema1:url <https://github.com/OHDSI/FeatureExtraction> .

kgr:ohdsi.hades a schema1:ProcessProduct ;
    rdfs:label "HADES" ;
    dcterms:description "OHDSI methods suite for standardized analytics on OMOP CDM data, including characterization, population-level effect estimation, and patient-level prediction" ;
    schema1:url <https://ohdsi.github.io/Hades/> .

