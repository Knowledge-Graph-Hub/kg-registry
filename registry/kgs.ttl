kgr:biofactoid a schema1:DataSource ;
    rdfs:label "Biofactoid" ;
    dcterms:created "2026-06-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "Biofactoid is a web-based system that empowers authors to capture and share machine-readable summaries of the molecular-level interactions between genes, gene products, and chemical compounds described in their publications. Author-sourced pathway knowledge is grounded to standard identifiers and made openly available in computable formats for reuse in pathway and network analysis." ;
    dcterms:identifier "biofactoid" ;
    dcterms:isReferencedBy <https://doi.org/10.7554/eLife.68292> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
