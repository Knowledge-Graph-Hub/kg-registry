        kgr:proteomehd.data,
        kgr:sri-reference-kg.graph,
        kgr:translator.goa.graph,
        kgr:translator.translator_kg.graph ;
    schema1:identifier "goa" ;
    schema1:name "GOA" ;
    skos:inScheme "biological systems",
        "genomics",
        "proteomics" ;
    adms:status "Active" ;
    foaf:homepage <https://www.ebi.ac.uk/GOA/> ;
    foaf:maker kgr:ebi .

