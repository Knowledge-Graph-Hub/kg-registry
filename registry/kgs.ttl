        kgr:pubchem.substances.asn,
        kgr:pubchem.substances.sdf ;
    schema1:name "LIPID MAPS" ;
    doap:repository <https://www.lipidmaps.org/databases/lmsd> ;
    skos:inScheme "biomedical",
        "chemistry and biochemistry",
        "nutrition" ;
    adms:status "Active" ;
    foaf:homepage <https://www.lipidmaps.org/> .

