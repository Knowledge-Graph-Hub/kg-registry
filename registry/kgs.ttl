kgr:tfacts a schema1:DataSource ;
    rdfs:label "TFactS" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "TFactS is a catalogue of literature-curated, signed transcription factor to target gene regulatory interactions, where each interaction records whether a transcription factor up-regulates or down-regulates its target. By comparing these curated \"regulons\" against differentially expressed genes, TFactS infers the activation or repression state of transcription factors from gene expression (microarray) data. It served as a foundational upstream source for the DoRothEA regulon collection. The original web service at tfacts.org is no longer operational and the domain has been re-registered for unrelated content." ;
    dcterms:identifier "tfacts" ;
    dcterms:isReferencedBy <https://pubmed.ncbi.nlm.nih.gov/20215436/> ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:dorothea.graph,
        kgr:tfacts.publication ;
    schema1:name "TFactS" ;
    skos:inScheme "genomics",
        "pathways",
        "systems biology" ;
    adms:status "Inactive" ;
    foaf:homepage <http://www.tfacts.org/> .

