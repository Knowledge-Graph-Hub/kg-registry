kgr:biobtree.graph.human-subgraph a schema1:GraphProduct ;
    rdfs:label "BioBTree Knowledge Graph - Human Subgraph (KGX)" ;
    dcterms:description "Human-scoped, Neo4j-ready subgraph of the BioBTree knowledge graph, exported as a biolink-typed KGX graph (~40M nodes / ~132M edges, ~8.3 GB compressed across separate node and edge files). A practical projection of the full graph for human-centric biomedical use. Published on Zenodo." ;
    schema1:url <https://zenodo.org/records/20816742> .

