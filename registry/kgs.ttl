kgr:obci a schema1:Ontology ;
    rdfs:label "Ontology for Biomarkers of Clinical Interest" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "An OWL-formatted ontology that formally defines biomarkers of clinical interest for diseases, phenotypes, and effects, including the FDA-NIH BEST-aligned biomarker role classifications (diagnostic, prognostic, predictive, monitoring, pharmacodynamic/response, safety, and susceptibility/risk biomarkers). OBCI is developed by the clinical-biomarkers group associated with the GlyGen and OncoMX biomarker data resources, and supplies the \"role\" / best-classification vocabulary used by downstream biomarker knowledge graphs." ;
    dcterms:identifier "obci" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:biomarker.bkg.edges.role,
        kgr:biomarker.bkg.nodes.role,
        kgr:obci.owl ;
    schema1:name "Ontology for Biomarkers of Clinical Interest" ;
    doap:repository <https://github.com/clinical-biomarkers/OBCI> ;
    skos:inScheme "biomedical",
        "clinical",
        "precision medicine" ;
    adms:status "Active" ;
    foaf:homepage <https://github.com/clinical-biomarkers/OBCI> .

