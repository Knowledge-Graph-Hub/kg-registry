        kgr:nlm-ckn.schema,
        kgr:nlm-ckn.scsilhouette,
        kgr:nlm-ckn.ui ;
    schema1:name "NLM-CKN" ;
    doap:repository <https://github.com/NIH-NLM/nlm-ckn> ;
    skos:inScheme "biological systems",
        "biomedical",
        "phenotype" ;
    adms:status "Active" ;
    foaf:homepage <https://nlm-ckn.org> .

