    adms:status "Active" ;
    foaf:homepage <https://opendataphilly.org/> .

kgr:openfema a schema1:DataSource ;
    rdfs:label "OpenFEMA" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "OpenFEMA is the U.S. Federal Emergency Management Agency's open-data program, providing public access to FEMA's program data. It publishes datasets covering federal disaster declarations, individual and public assistance, hazard mitigation, flood insurance, and other emergency-management programs. Data are distributed as downloadable files and through a versioned RESTful API. OpenFEMA is an upstream source for KnowWhereGraph." ;
    dcterms:identifier "openfema" ;
    dcterms:license <https://www.usa.gov/government-works> ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
