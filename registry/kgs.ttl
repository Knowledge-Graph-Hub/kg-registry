    foaf:homepage <https://github.com/NCATSTranslator/Translator-All/wiki/Translator-Curated-Query-Service> .

kgr:craft a schema1:DataSource ;
    rdfs:label "Colorado Richly Annotated Full-Text Corpus" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Colorado Richly Annotated Full-Text (CRAFT) Corpus is a manually annotated corpus of full-text biomedical journal articles. It provides concept annotations against multiple biomedical ontologies along with syntactic and coreference annotations, serving as a gold-standard resource for biomedical natural language processing." ;
    dcterms:identifier "craft" ;
    dcterms:isReferencedBy <https://doi.org/10.1186/1471-2105-13-161> ;
