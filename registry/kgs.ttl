        kgr:genecards.web.interface ;
    schema1:name "Conserved Domain Database" ;
    skos:inScheme "genomics",
        "proteomics" ;
    adms:status "Active" ;
    foaf:homepage <https://www.ncbi.nlm.nih.gov/Structure/cdd/cdd.shtml> .

