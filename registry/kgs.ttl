        kgr:openfema.api,
        kgr:openfema.datasets ;
    schema1:name "OpenFEMA" ;
    skos:inScheme "environment",
        "general",
        "public health" ;
    adms:status "Active" ;
    foaf:homepage <https://www.fema.gov/about/openfema> .

kgr:opengwas a schema1:DataSource ;
