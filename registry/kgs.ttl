kgr:gad a schema1:DataSource ;
    rdfs:label "Genetic Association Database" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Genetic Association Database (GAD) was an archive of human genetic association studies compiled from peer-reviewed literature, cataloging reported links between genes and complex diseases or phenotypes. Developed and hosted at the U.S. National Institutes of Health (NIH), it aimed to support standardized analysis of gene-disease associations. The resource has been archived and is no longer maintained or updated, and its original web portal is no longer reachable. GAD served as an upstream primary source for downstream resources such as PharmDB." ;
    dcterms:identifier "gad" ;
    dcterms:isReferencedBy <https://www.ncbi.nlm.nih.gov/pubmed/15118671> ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:gad.publication,
        kgr:pharmdb.graph ;
    schema1:name "Genetic Association Database" ;
    skos:inScheme "clinical",
        "genomics",
        "phenotype" ;
    adms:status "Inactive" ;
    foaf:homepage <https://geneticassociationdb.nih.gov/> .

kgr:gadm a schema1:DataSource ;
    rdfs:label "GADM" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "GADM (Database of Global Administrative Areas) provides maps and spatial data of administrative boundaries for all countries and their sub-divisions. The current version (4.1) delimits over 400,000 administrative areas across multiple levels, from countries down to local divisions. The polygons are distributed for download by country or for the entire world in several geospatial formats. GADM is used as an upstream source of administrative boundary data by projects such as KnowWhereGraph." ;
    dcterms:identifier "gadm" ;
    dcterms:license "GADM license (free for academic/non-commercial use)" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:gadm.download_country,
        kgr:gadm.download_world,
        kgr:gadm.metadata,
        kgr:knowwheregraph.graph ;
    schema1:name "GADM" ;
    skos:altLabel "Database of Global Administrative Areas" ;
    skos:inScheme "environment",
        "general",
        "information technology" ;
    adms:status "Active" ;
    foaf:homepage <https://gadm.org/> .

kgr:gallont a schema1:Ontology ;
    rdfs:label "Plant Gall Ontology" ;
    dcterms:created "2025-09-29T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "Ontology of plant gall phenotypes. Plant galls are novel plant structures, generated by plants in response to biotic stressors. This ontology is used to annotate gall phenotypes (e.g., their colors, textures, sizes, locations on the plant) in a semantic way, in order to facilitate discoveries about the genetic and physiologic mechanisms responsible for such phenotypes. The ontology can also be used as a controlled vocabulary for natural language descriptions of plant galls." ;
    dcterms:identifier "gallont" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-08-06T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:gallont.kg-bioportal,
        kgr:gallont.obo,
        kgr:gallont.owl ;
    schema1:name "Plant Gall Ontology" ;
    doap:repository <https://github.com/adeans/gallont> ;
    skos:inScheme "biological systems",
        "phenotype" ;
    adms:status "Active" ;
    foaf:homepage <https://adeans.github.io/gallont/> .

