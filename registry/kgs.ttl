kgr:icgc a schema1:DataSource ;
    rdfs:label "ICGC" ;
    dcterms:created "2026-06-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The International Cancer Genome Consortium (ICGC) is a global initiative to characterize the genomic, transcriptomic, and epigenomic changes in 50 different tumor types and subtypes. It generates comprehensive catalogues of somatic mutations and other cancer genomics data, made available to the research community. The original ICGC Data Portal (dcc.icgc.org) was retired in June 2024, with ICGC 25K data and the successor ICGC ARGO project continuing to provide access to cancer genomics datasets." ;
    dcterms:identifier "icgc" ;
    dcterms:isReferencedBy <https://doi.org/10.1038/nature08987> ;
    dcterms:license <https://platform.icgc-argo.org/> ;
    dcterms:modified "2026-06-05T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:biomuta.dataset,
        kgr:icgc.downloads,
        kgr:icgc.platform ;
    schema1:name "ICGC" ;
    skos:altLabel "ICGC ARGO",
