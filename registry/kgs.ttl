        kgr:hrpimp.data,
        kgr:hrpimp.huri.psi,
        kgr:hrpimp.web ;
    schema1:name "Human Reference Protein Interactome Mapping Project" ;
    doap:repository <https://github.com/CCSB-DFCI/HuRI_paper> ;
    skos:altLabel "HRPIMP",
        "HuRI",
        "Human Reference Interactome" ;
    skos:inScheme "biological systems",
        "biomedical",
        "proteomics",
        "systems biology" ;
    adms:status "Active" ;
    foaf:homepage <https://www.interactome-atlas.org/> .

