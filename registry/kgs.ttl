    doap:repository <https://github.com/MaayanLab/CFDE-KG> ;
    skos:inScheme "biological systems",
        "biomedical",
        "genomics",
        "systems biology" ;
    adms:status "Active" ;
    foaf:homepage <https://gse.cfde.cloud/> .

