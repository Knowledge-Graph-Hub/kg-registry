kgr:ccre a schema1:DataSource ;
    rdfs:label "ENCODE cCRE Registry (SCREEN)" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The ENCODE Registry of candidate cis-Regulatory Elements (cCREs) is a curated annotation of regulatory regions in the human and mouse genomes derived from ENCODE and Roadmap Epigenomics data. Each cCRE is classified by its biochemical signature, including promoter-like, enhancer-like, and CTCF-bound elements based on DNase hypersensitivity, H3K4me3, H3K27ac, and CTCF ChIP-seq signals. The registry is explorable through the SCREEN (Search Candidate cis-Regulatory Elements by ENCODE) web portal, which lets users browse cCREs and their activity across cell types and tissues. cCREs/SCREEN are produced as part of the ENCODE project and serve as an upstream source for downstream resources such as GenomicKB." ;
    dcterms:identifier "ccre" ;
    dcterms:isReferencedBy <https://pubmed.ncbi.nlm.nih.gov/32728249/> ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:ccre.screen,
        kgr:genomickb.graph ;
    schema1:name "ENCODE cCRE Registry (SCREEN)" ;
    skos:inScheme "biological systems",
        "genomics",
        "systems biology" ;
    adms:status "Active" ;
    foaf:homepage <https://screen.encodeproject.org/> .

