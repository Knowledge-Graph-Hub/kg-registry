kgr:dbptm a schema1:DataSource ;
    rdfs:label "dbPTM" ;
    dcterms:created "2026-06-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "dbPTM is an integrated protein post-translational modification resource that curates experimentally verified PTM sites, literature evidence, proteomic datasets, regulatory networks, and disease-associated PTM annotations." ;
