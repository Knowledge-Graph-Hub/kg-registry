kgr:cellphonedb a schema1:DataSource ;
    rdfs:label "CellPhoneDB" ;
    dcterms:created "2026-06-15T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "CellPhoneDB is a publicly available repository of manually curated human receptors, ligands and their interactions, paired with a statistical tool to infer cell-cell communication from single-cell transcriptomics data. It accounts for the subunit architecture of both ligands and receptors, accurately representing heteromeric complexes, and predicts enriched signaling between cell types based on the combined expression of interacting partners." ;
    dcterms:identifier "cellphonedb" ;
    dcterms:isReferencedBy <doi:10.1038/s41596-020-0292-x> ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
