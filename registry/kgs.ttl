kgr:us-census a schema1:DataSource ;
    rdfs:label "United States Census Bureau" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The United States Census Bureau is the federal agency responsible for producing demographic, socioeconomic, and geographic data about the people and economy of the United States. Its data products include the decennial Census, the American Community Survey (ACS), economic and business surveys, and TIGER/Line geographic boundary files. These datasets are widely reused for socioeconomic linkage and administrative geography enrichment in downstream knowledge graphs." ;
    dcterms:identifier "us-census" ;
    dcterms:license "U.S. Government Work (public domain)" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:cancer-registry-kg.cdi,
        kgr:geoconnex.graph,
        kgr:knowwheregraph.graph,
        kgr:nikg.graph,
        kgr:ruralkg.graph,
        kgr:sawgraph.graph,
        kgr:spatialkg.graph,
        kgr:sudokn.graph,
        kgr:us-census.api,
        kgr:us-census.data ;
    schema1:name "United States Census Bureau" ;
    skos:inScheme "general",
        "information technology",
        "public health" ;
    adms:status "Active" ;
    foaf:homepage <https://www.census.gov/> .

kgr:usdm a schema1:DataSource ;
    rdfs:label "U.S. Drought Monitor" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The U.S. Drought Monitor (USDM) is a weekly map and dataset that classifies the location and severity of drought across the United States, its territories, and tribal areas. It is produced jointly by the National Drought Mitigation Center at the University of Nebraska-Lincoln, the U.S. Department of Agriculture, and the National Oceanic and Atmospheric Administration, drawing on numerous climatic and hydrologic indicators plus local expert input. USDM data and maps serve as an upstream source for KnowWhereGraph." ;
    dcterms:identifier "usdm" ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:knowwheregraph.graph,
        kgr:usdm.data,
        kgr:usdm.map ;
    schema1:name "U.S. Drought Monitor" ;
    skos:inScheme "agriculture",
        "environment",
        "public health" ;
    adms:status "Active" ;
    foaf:homepage <https://droughtmonitor.unl.edu/> .

kgr:usgs a schema1:DataSource ;
    rdfs:label "U.S. Geological Survey (USGS)" ;
    dcterms:created "2026-07-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The U.S. Geological Survey (USGS) is the science agency of the U.S. Department of the Interior. It produces and publishes data and research across the biological, geological, hydrological, and geographic sciences, and distributes datasets through its data repositories, including the ScienceBase catalog." ;
    dcterms:identifier "usgs" ;
    dcterms:license <https://www.usa.gov/government-works> ;
    dcterms:modified "2026-07-03T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:usgs.data,
        kgr:usgs.sciencebase,
        kgr:wildlifekn.graph ;
    schema1:name "U.S. Geological Survey (USGS)" ;
    skos:inScheme "environment",
        "general" ;
    adms:status "Active" ;
    foaf:homepage <https://www.usgs.gov/> .

kgr:usgs-comcat a schema1:DataSource ;
    rdfs:label "USGS Comprehensive Earthquake Catalog (ComCat)" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Advanced National Seismic System (ANSS) Comprehensive Earthquake Catalog (ComCat) is the U.S. Geological Survey's authoritative catalog of earthquake events. It aggregates seismic event records contributed by ANSS networks and other sources, including event origins (location, depth, and time), magnitudes, and associated phase and product data. ComCat is accessible through a web-based earthquake search interface and a programmatic FDSN-standard event web service, and serves as an upstream source for the KnowWhereGraph." ;
    dcterms:identifier "usgs-comcat" ;
    dcterms:license "U.S. federal government public domain" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:knowwheregraph.graph,
        kgr:usgs-comcat.fdsnws,
        kgr:usgs-comcat.search ;
    schema1:name "USGS Comprehensive Earthquake Catalog (ComCat)" ;
    skos:inScheme "environment",
        "general",
        "information technology" ;
    adms:status "Active" ;
    foaf:homepage <https://earthquake.usgs.gov/data/comcat/> .

kgr:usgs-nhd a schema1:DataSource ;
    rdfs:label "USGS National Hydrography Dataset (NHD)" ;
    dcterms:created "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The National Hydrography Dataset (NHD) is the U.S. Geological Survey's authoritative geospatial representation of the surface water features of the United States, including rivers, streams, canals, lakes, ponds, and other waterbodies. The associated NHDPlus products add value with flow direction, network connectivity (NHDFlowline), waterbody features (NHDWaterbody), and catchment attributes. SAWGraph uses NHD and NHDPlus data as a geospatial reference source for modeling surface water features and the flowlines that connect them, supporting spatial context for PFAS observations." ;
    dcterms:identifier "usgs-nhd" ;
    dcterms:license "U.S. federal government public domain" ;
    dcterms:modified "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:geoconnex.graph,
        kgr:hydrologykg.graph,
        kgr:sawgraph.graph,
        kgr:uf-okn.graph,
        kgr:usgs-nhd.landing,
        kgr:usgs-nhd.nhdplus ;
    schema1:name "USGS National Hydrography Dataset (NHD)" ;
    skos:inScheme "environment",
        "general" ;
    adms:status "Active" ;
    foaf:homepage <https://www.usgs.gov/national-hydrography/national-hydrography-dataset> .

kgr:usgs-nwis a schema1:DataSource ;
    rdfs:label "USGS National Water Information System (NWIS)" ;
    dcterms:created "2026-07-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The National Water Information System (NWIS) is the U.S. Geological Survey's principal repository of water resources data for the United States, providing access to surface water, groundwater, and water quality data collected at monitoring sites and stream gages nationwide. NWIS is the authoritative source for USGS streamgage monitoring locations and national aquifer information. Geoconnex draws on NWIS as the source of record for its reference stream gage monitoring locations and USGS National Aquifer reference features." ;
    dcterms:identifier "usgs-nwis" ;
    dcterms:license "U.S. federal government public domain" ;
    dcterms:modified "2026-07-02T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:geoconnex.graph,
        kgr:usgs-nwis.landing ;
    schema1:name "USGS National Water Information System (NWIS)" ;
    skos:inScheme "environment",
        "general" ;
    adms:status "Active" ;
    foaf:homepage <https://waterdata.usgs.gov/nwis> .

