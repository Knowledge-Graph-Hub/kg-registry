    schema1:identifier "darkkinasekb" ;
    schema1:name "Dark Kinase Knowledgebase" ;
    skos:altLabel "DKK" ;
    skos:inScheme "genomics",
        "proteomics" ;
    adms:status "Active" ;
    foaf:homepage <https://darkkinome.org> .

