    skos:inScheme "chemistry and biochemistry",
        "proteomics" ;
    adms:status "Active" ;
    foaf:homepage <http://sfld.rbvi.ucsf.edu/> .

kgr:sgd a schema1:DataSource ;
    rdfs:label "Saccharomyces Genome Database" ;
    dcterms:created "2025-03-09T00:00:00+00:00"^^xsd:dateTime ;
