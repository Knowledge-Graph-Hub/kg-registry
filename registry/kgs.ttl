kgr:cmip a schema1:DataSource ;
    rdfs:label "Coupled Model Intercomparison Project (CMIP)" ;
    dcterms:created "2026-07-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Coupled Model Intercomparison Project (CMIP) is a coordinated climate modeling framework organized under the World Climate Research Programme (WCRP). Its CMIP6 Controlled Vocabularies (CMIP6CV) define the standardized identifiers used across CMIP, including source_id (models), experiment_id (experiments), activity_id (MIP activities), and institution_id, published as machine-readable files." ;
    dcterms:identifier "cmip" ;
    dcterms:modified "2026-07-03T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:climatemodelskg.graph,
