kgr:water-quality-portal a schema1:DataSource ;
    rdfs:label "Water Quality Portal (WQP)" ;
    dcterms:created "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Water Quality Portal (WQP) is a cooperative water quality data service sponsored by the US Geological Survey, the US Environmental Protection Agency, and the National Water Quality Monitoring Council. It integrates publicly available water quality monitoring data from hundreds of federal, state, tribal, and local organizations, exposing monitoring locations, sampling activities, and characteristic results (including per- and polyfluoroalkyl substance, PFAS, measurements) through a standardized web service. SAWGraph uses WQP water quality monitoring results as a primary source for PFAS occurrence in surface water and groundwater." ;
    dcterms:identifier "water-quality-portal" ;
    dcterms:license "US federal government public domain" ;
    dcterms:modified "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:sawgraph.graph,
        kgr:water-quality-portal.landing,
        kgr:water-quality-portal.webservices ;
    schema1:name "Water Quality Portal (WQP)" ;
    skos:inScheme "chemistry and biochemistry",
        "environment",
        "public health" ;
    adms:status "Active" ;
    foaf:homepage <https://www.waterqualitydata.us/> .

