kgr:era-kg.ontology a schema1:OntologyProduct ;
    rdfs:label "ERA Vocabulary (ERA Ontology)" ;
    dcterms:description "The ERA Vocabulary (ERA Ontology), defined by the European Union Agency for Railways to describe European railway infrastructure and the vehicles authorized to operate over it. It carries roughly 76 classes, 600 properties, and 52 annotation properties, along with more than 80 SKOS concept schemes for coded parameter values, and is distributed with SHACL shapes for validating conforming data." ;
    schema1:url <https://data-interop.era.europa.eu/era-vocabulary/> .

kgr:era-kg.portal a schema1:GraphicalInterface ;
    rdfs:label "RINF Linked Data Portal" ;
    dcterms:description "RINF linked data portal, the Agency's entry point for the infrastructure knowledge graph, with documentation of the data model and access paths." ;
    schema1:url <https://rinf.data.era.europa.eu/> .

kgr:era-kg.sparql a schema1:ProgrammingInterface ;
    rdfs:label "ERA Knowledge Graph SPARQL Endpoint (RINF+)" ;
    dcterms:description "Public SPARQL endpoint over the RINF+ repository, the infrastructure graph expressed with the ERA Ontology 3.1.x model, served from the Agency's GraphDB deployment. Verified queryable on 2026-08-06, when the repository reported 53,716,816 triples. Companion repositories on the same deployment hold the ERA ontology itself (OWL, SKOS, and SHACL) and references to railway legislation." ;
    schema1:url <https://graph.data.era.europa.eu/repositories/rinf-plus> .

kgr:ero.kg-bioportal a schema1:GraphProduct ;
    rdfs:label "ERO KGX graph (KG-Bioportal)" ;
    dcterms:description "KGX TSV transform of Eagle-I Research Resource Ontology (ERO), produced by KG-Bioportal from the BioPortal submission. The archive contains ERO_nodes.tsv and ERO_edges.tsv." ;
    schema1:url <https://github.com/ncbo/kg-bioportal/releases/download/data-2026.07/ERO.tar.gz> .

kgr:ero.owl a schema1:OntologyProduct ;
    rdfs:label "ero.owl" ;
    dcterms:description "eagle-i resource ontology in OWL format" ;
    schema1:url <http://purl.obolibrary.org/obo/ero.owl> .

kgr:esgf.search a schema1:ProgrammingInterface ;
    rdfs:label "ESGF Search" ;
    dcterms:description "The ESGF search interface (MetaGrid / AIMS) provides discovery and access to climate dataset metadata across the federation, including CMIP model output indexed by source_id, experiment_id, variable_id, and activity_id." ;
    schema1:url <https://metagrid.esgf-west.org/search> .

kgr:eu-knowledge-graph.api a schema1:ProgrammingInterface ;
    rdfs:label "EU Knowledge Graph Wikibase API" ;
    dcterms:description "MediaWiki and Wikibase action API of the EU Knowledge Graph instance, supporting entity retrieval, search, and change tracking. Verified responding on 2026-08-06." ;
    schema1:url <https://linkedopendata.eu/w/api.php> .

kgr:eu-knowledge-graph.exports a schema1:GraphProduct ;
    rdfs:label "EU Knowledge Graph Data Exports" ;
    dcterms:description "Data exports of the EU Knowledge Graph, advertised on the instance's main page as available from data.linkedopendata.eu." ;
    schema1:url <https://data.linkedopendata.eu> .

kgr:eu-knowledge-graph.kohesio a schema1:GraphicalInterface ;
    rdfs:label "Kohesio" ;
    dcterms:description "Kohesio, the main public-facing application built on the EU Knowledge Graph. It presents EU cohesion policy projects and their beneficiaries to the public, with map and search based discovery. Kohesio won the European Ombudsman's 2023 award for good administration in the open administration category." ;
    schema1:url <https://kohesio.ec.europa.eu/> .

kgr:eu-knowledge-graph.qa a schema1:GraphicalInterface ;
    rdfs:label "EU Knowledge Graph Question Answering Service" ;
    dcterms:description "Question answering service over the EU Knowledge Graph, allowing natural language questions to be posed against the graph." ;
    schema1:url <https://qa.linkedopendata.eu> .

kgr:eu-knowledge-graph.query-service a schema1:GraphicalInterface ;
    rdfs:label "EU Knowledge Graph Query Service" ;
    dcterms:description "Query service interface for the EU Knowledge Graph, in the style of the Wikidata Query Service, providing an editor and result views over the SPARQL endpoint." ;
    schema1:url <https://query.linkedopendata.eu/> .

kgr:eu-knowledge-graph.sparql a schema1:ProgrammingInterface ;
    rdfs:label "EU Knowledge Graph SPARQL Endpoint" ;
    dcterms:description "Public SPARQL endpoint of the EU Knowledge Graph query service. Verified queryable on 2026-08-06, when it reported 889,454,967 triples." ;
    schema1:url <https://query.linkedopendata.eu/sparql> .

kgr:eu-knowledge-graph.wikibase a schema1:GraphicalInterface ;
    rdfs:label "EU Knowledge Graph Wikibase" ;
    dcterms:description "The Wikibase instance itself, where items and statements can be browsed and, for authorized editors signed in through EU Login, edited. The instance reported 3,801,954 pages and more than 48 million edits on 2026-08-06, with edits from Commission services taking place the same day." ;
    schema1:url <https://linkedopendata.eu/> .

kgr:eu-knowledge-graph.wikibase-config a schema1:ProcessProduct ;
