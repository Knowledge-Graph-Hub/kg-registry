kgr:sparc a schema1:DataSource ;
    rdfs:label "Stimulating Peripheral Activity to Relieve Conditions (SPARC)" ;
    dcterms:created "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "Stimulating Peripheral Activity to Relieve Conditions (SPARC) is an NIH Common Fund program that accelerates development of therapeutic devices modulating electrical activity in nerves to improve organ function (bioelectronic medicine). The SPARC Portal (sparc.science) is a public resource that shares curated data sets, anatomical and functional maps, and predictive computational models describing the autonomic and peripheral nervous system and its connections to internal organs. Resources can be shared, cited, visualized, computed on, and used for virtual experimentation to advance bioelectronic medicine." ;
    dcterms:identifier "sparc" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    schema1:about <NCBITaxon:9606> ;
    schema1:hasPart kgr:digcfdekg.graph,
        kgr:sparc.data,
        kgr:sparc.portal ;
    schema1:name "Stimulating Peripheral Activity to Relieve Conditions (SPARC)" ;
    skos:altLabel "SPARC",
        "Stimulating Peripheral Activity to Relieve Conditions" ;
    skos:inScheme "anatomy and development",
        "biomedical",
        "neuroscience" ;
    adms:status "Active" ;
    foaf:homepage <https://sparc.science/> .

kgr:spatialkg a schema1:KnowledgeGraph ;
    rdfs:label "SAWGraph Spatial KG" ;
    dcterms:created "2025-12-08T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The SAWGraph Spatial KG is part of the Safe Agricultural Products and Water Graph (SAWGraph) project. It contains all the Level 13 grid cells from the S2 grid as well as administrative regions of levels 1 to 3 (states, counties, and county subdivisions) and the spatial relationships between them for the 48 contiguous states in the U.S." ;
    dcterms:identifier "spatialkg" ;
