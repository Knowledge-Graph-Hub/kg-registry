kgr:era-kg.dump a schema1:GraphProduct ;
    rdfs:label "ERA Knowledge Graph Dump" ;
    dcterms:description "Periodic full dump of the infrastructure knowledge graph, archived on Zenodo under a versioned series with a concept DOI covering all releases. The most recent release identified is v9.0 of 2026-06-29, a 3.75 GB TriG file (rinfplus.trig); earlier releases were compressed N-Quads. The edge count recorded here is the triple count reported by the live RINF+ repository on 2026-08-06." ;
    schema1:url <https://doi.org/10.5281/zenodo.14605743> .

kgr:era-kg.graphdb a schema1:GraphicalInterface ;
