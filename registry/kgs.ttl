kgr:dgv a schema1:DataSource ;
    rdfs:label "Database of Genomic Variants" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Database of Genomic Variants (DGV) provides a curated catalogue of structural variation in the genomes of control individuals from healthy populations. It compiles copy-number variants, insertions, deletions, inversions, and other structural variants reported in the literature to provide a reference for studies of genomic disorders." ;
    dcterms:identifier "dgv" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/nar/gkt958> ;
