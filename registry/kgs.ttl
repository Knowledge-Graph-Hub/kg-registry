kgr:dbsuper a schema1:DataSource ;
    rdfs:label "dbSUPER" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "dbSUPER is an integrated and interactive database of super-enhancers in mouse and human genomes. It provides a centralized resource of super-enhancer regions with associated genes, cell and tissue types, and supporting genomic data to assist studies of transcriptional control of cell identity and disease." ;
    dcterms:identifier "dbsuper" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/nar/gkv1002> ;
