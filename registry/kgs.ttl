kgr:alphafold a schema1:DataSource ;
    rdfs:label "AlphaFold Protein Structure Database" ;
    dcterms:created "2026-06-15T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The AlphaFold Protein Structure Database (AlphaFold DB) is a freely accessible database of predicted protein structures developed by Google DeepMind and EMBL-EBI. It provides open access to over 200 million protein structure predictions generated by the AlphaFold deep learning system, covering the human proteome and the proteomes of many other organisms as well as the UniProt reference proteomes. Each entry includes the predicted three-dimensional structure together with per-residue confidence (pLDDT) and predicted aligned error (PAE) metrics." ;
    dcterms:identifier "alphafold" ;
    dcterms:isReferencedBy <doi:10.1038/s41586-021-03819-2>,
        <doi:10.1093/nar/gkab1061> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-06-15T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:alphafold.api,
        kgr:alphafold.docs,
        kgr:alphafold.downloads,
        kgr:alphafold.web,
        kgr:biobtree.api,
        kgr:biobtree.graph.human-subgraph,
        kgr:genecards.web.interface ;
    schema1:name "AlphaFold Protein Structure Database" ;
    doap:repository <https://github.com/google-deepmind/alphafold> ;
    skos:inScheme "biomedical",
        "proteomics",
        "systems biology" ;
    adms:status "Active" ;
    foaf:homepage <https://alphafold.ebi.ac.uk/> .

kgr:alphamissense a schema1:DataSource ;
    rdfs:label "AlphaMissense" ;
    dcterms:created "2026-06-15T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "AlphaMissense is a deep learning model from Google DeepMind that predicts the pathogenicity of missense variants across the human proteome. It provides precomputed pathogenicity scores and classifications (likely benign, likely pathogenic, or ambiguous) for all approximately 71 million possible single amino acid substitutions in the human genome, as well as substitution effect scores for the entire proteome. The predictions are distributed via bulk download and accessible through hosted viewers and genome browsers." ;
    dcterms:identifier "alphamissense" ;
    dcterms:isReferencedBy <doi:10.1126/science.adg7492> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-06-15T00:00:00+00:00"^^xsd:dateTime ;
    schema1:about <NCBITaxon:9606> ;
    schema1:hasPart kgr:alphamissense.docs,
        kgr:alphamissense.predictions,
        kgr:alphamissense.software,
        kgr:alphamissense.viewer,
        kgr:biobtree.api,
        kgr:biobtree.graph.human-subgraph ;
    schema1:name "AlphaMissense" ;
    doap:repository <https://github.com/google-deepmind/alphamissense> ;
    skos:inScheme "biomedical",
        "clinical",
        "genomics",
        "precision medicine",
        "proteomics" ;
    adms:status "Active" ;
    foaf:homepage <https://github.com/google-deepmind/alphamissense> .

