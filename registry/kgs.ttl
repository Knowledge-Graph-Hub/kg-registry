        kgr:gendr.web ;
    schema1:identifier "gendr" ;
    schema1:name "GenDR Database of Dietary Restriction-Related Genes" ;
    skos:altLabel "GenDR",
        "gendr" ;
    skos:inScheme "biological systems",
        "biomedical",
        "genomics",
        "nutrition" ;
    adms:status "Active" ;
    foaf:homepage <https://hagr.ageing-map.org/diet/> .

