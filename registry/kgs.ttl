kgr:endb a schema1:DataSource ;
    rdfs:label "ENdb" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "ENdb is a manually curated database of experimentally validated enhancers for human and mouse, compiled from published literature. Each entry links an enhancer to its experimentally supported target gene(s) and includes detailed regulatory annotations such as the validation experiment type, associated transcription factors, disease and tissue/cell-line context, and references to the supporting publications. The database provides browse, search, genome browser, and bulk download interfaces, and serves as an upstream primary source for integrated resources including GenomicKB." ;
    dcterms:identifier "endb" ;
    dcterms:isReferencedBy <https://pubmed.ncbi.nlm.nih.gov/31665430> ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:endb.browse,
        kgr:endb.download,
        kgr:genomickb.graph ;
    schema1:name "ENdb" ;
    skos:inScheme "biomedical",
        "genomics",
        "systems biology" ;
    adms:status "Active" ;
    foaf:homepage <http://www.licpathway.net/ENdb/> .

kgr:enhanceratlas a schema1:DataSource ;
    rdfs:label "EnhancerAtlas" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "EnhancerAtlas is a genome-wide atlas of enhancer annotations spanning a large number of human and animal cell and tissue types. The resource integrates diverse high-throughput experimental datasets (including histone modifications, DNase-seq, transcription factor binding, and other epigenomic signals) to predict consensus enhancer regions and infer enhancer-target gene interactions. EnhancerAtlas 2.0 provides enhancer annotations for 586 tissue and cell types across nine species, making it a comprehensive reference for regulatory genomics. It serves as an upstream data source for the GenomicKB knowledge graph." ;
    dcterms:identifier "enhanceratlas" ;
    dcterms:isReferencedBy <https://pubmed.ncbi.nlm.nih.gov/31740966/> ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:enhanceratlas.browse,
        kgr:enhanceratlas.download,
        kgr:genomickb.graph ;
    schema1:name "EnhancerAtlas" ;
    skos:inScheme "biological systems",
        "genomics",
        "systems biology" ;
    adms:status "Active" ;
    foaf:homepage <http://www.enhanceratlas.org/> .

kgr:enrichr a schema1:DataSource ;
    rdfs:label "Enrichr" ;
    dcterms:created "2026-05-21T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "Enrichr is a Ma'ayan Lab web-based gene set enrichment analysis resource that accepts gene lists and related inputs, tests them against hundreds of curated and crowd-sourced gene set libraries, and provides ranked enrichment results, visualizations, and programmatic access." ;
    dcterms:identifier "enrichr" ;
    dcterms:isReferencedBy <doi:10.1093/nar/gkw377>,
        <doi:10.1186/1471-2105-14-128> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-06-02T00:00:00+00:00"^^xsd:dateTime ;
    schema1:about <NCBITaxon:9606> ;
    schema1:hasPart kgr:chea-kg.graph,
        kgr:chea-kg.libraries,
        kgr:chea.libraries,
        kgr:enrichr-kg.api,
