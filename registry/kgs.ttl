    dcterms:created "2026-06-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "P3DB, the Plant Protein Phosphorylation Database, is a plant phosphoproteomics resource that collects phosphorylation sites, phosphopeptides, kinases, organisms, and study datasets with search and BLAST tools." ;
