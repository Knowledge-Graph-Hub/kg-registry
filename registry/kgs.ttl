    dcterms:created "2026-06-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "dbSNO is a protein S-nitrosylation database that curates experimentally verified S-nitrosylated proteins and cysteine sites with structural, functional, disease, and regulatory network annotations." ;
