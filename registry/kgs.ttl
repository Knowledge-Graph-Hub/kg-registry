    dcterms:created "2026-08-12T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "A harmonized and imputed canine variant atlas, unifying genotypes from fifteen previously incomparable dog cohorts into a single set of 9.67 million variants on the CanFam4 reference assembly." ;
