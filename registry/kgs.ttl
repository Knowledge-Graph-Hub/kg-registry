    skos:inScheme "biomedical",
        "clinical",
        "genomics",
        "phenotype" ;
    adms:status "Active" ;
    foaf:homepage <https://www.orphadata.com/ordo/> .

kgr:oreganno a schema1:DataSource ;
    rdfs:label "ORegAnno" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "ORegAnno (the Open Regulatory Annotation database) is a community-driven, literature-curated resource of regulatory regions, transcription factor binding sites, regulatory polymorphisms, and regulatory interactions across multiple species. It served as an upstream primary source for regulatory annotation resources such as DoRothEA. The original standalone interactive site (oreganno.org) is no longer operational and now redirects to the UCSC Genome Browser; the curated ORegAnno 3.0 data set lives on as a track and bulk download in the UCSC Genome Browser and is also distributed via Ensembl." ;
    dcterms:identifier "oreganno" ;
    dcterms:isReferencedBy <https://www.ncbi.nlm.nih.gov/pubmed/26578589> ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:dorothea.graph,
        kgr:oreganno.ucsc ;
    schema1:name "ORegAnno" ;
    skos:inScheme "genomics",
        "systems biology" ;
    adms:status "Inactive" ;
    foaf:homepage <https://genome.ucsc.edu/cgi-bin/hgTrackUi?org=Human&g=oreganno> .

