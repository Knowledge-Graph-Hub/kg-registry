    adms:status "Inactive" ;
    foaf:homepage <http://www.lncrnadb.org/> .

kgr:lncrnadisease a schema1:DataSource ;
    rdfs:label "LncRNADisease" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "LncRNADisease is a database of experimentally supported and predicted long non-coding RNA (lncRNA) and disease associations. It also curates lncRNA interactions at various molecular levels, including with proteins, RNA, miRNA, and DNA, to support studies of lncRNA function in disease." ;
    dcterms:identifier "lncrnadisease" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/nar/gky905> ;
    dcterms:modified "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:genecards.web.interface,
        kgr:lncrnadisease.site ;
    schema1:name "LncRNADisease" ;
    skos:inScheme "clinical",
        "genomics" ;
    adms:status "Active" ;
    foaf:homepage <http://www.rnanut.net/lncrnadisease/> .

kgr:lncrnalyzr a schema1:KnowledgeGraph ;
    rdfs:label "lncRNAlyzr" ;
    dcterms:created "2025-09-23T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "lncRNAlyzr is a specialized knowledge graph focused on long non-coding RNA (lncRNA) biology, integrating lncRNA annotations, expression profiles, functional interactions, disease associations, and regulatory mechanisms to provide comprehensive insights into lncRNA roles in cellular processes and human disease." ;
    dcterms:identifier "lncrnalyzr" ;
