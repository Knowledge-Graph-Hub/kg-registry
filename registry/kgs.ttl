    schema1:url <https://github.com/NIH-NLM/nlm-ckn-schema/blob/main/ckn-schema.yaml> .

kgr:nlm-ckn.scsilhouette a schema1:ProcessProduct ;
    rdfs:label "scsilhouette" ;
    dcterms:description "The scsilhouette Python package, part of the NLM-CKN quality-control workflow. Together with NSForest F-scores it computes silhouette and summary quality metrics that characterize the single-cell clusters used in the knowledgebase." ;
    schema1:url <https://github.com/NIH-NLM/scsilhouette> .

