        kgr:np-kg.graph.tsv ;
    schema1:name "NP-KG" ;
    doap:repository <https://github.com/sanyabt/np-kg> ;
    skos:inScheme "biomedical",
        "drug discovery",
        "pharmacology" ;
    adms:status "Active" ;
    foaf:homepage <https://doi.org/10.5281/zenodo.6814507> .

kgr:npass a schema1:DataSource ;
    rdfs:label "NPASS" ;
    dcterms:created "2026-02-26T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "NPASS is a natural products database that integrates species sources, chemical structures, biological targets, quantitative activity data, and ADME-toxicity information." ;
    dcterms:identifier "npass" ;
    dcterms:isReferencedBy <https://www.ncbi.nlm.nih.gov/pubmed/36624664> ;
