kgr:matador a schema1:DataSource ;
    rdfs:label "MATADOR" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "MATADOR (Manually Annotated Targets and Drugs Online Resource) is a manually curated database of drug-target relationships developed at EMBL. Unlike resources limited to direct binding, MATADOR captures both direct (binding) and indirect (e.g., metabolic or signaling) drug-target interactions for proteins and small molecules. It was distributed alongside SuperTarget and serves as an upstream source for downstream knowledge graphs such as PharmDB." ;
    dcterms:identifier "matador" ;
    dcterms:isReferencedBy <https://pubmed.ncbi.nlm.nih.gov/17942422/> ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
