        kgr:sri-reference-kg.graph ;
    schema1:identifier "rgd" ;
    schema1:name "Rat Genome Database" ;
    doap:repository <https://github.com/rat-genome-database> ;
    skos:altLabel "RGD" ;
    skos:inScheme "biological systems",
