kgr:bitterdb a schema1:DataSource ;
    rdfs:label "BitterDB" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "BitterDB is a database of bitter-tasting compounds and their associated bitter taste receptors. It compiles bitter molecules reported in the literature together with the human and other species' bitter taste receptors (T2Rs) they activate, supporting research in chemoreception and ligand-receptor pharmacology." ;
    dcterms:identifier "bitterdb" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/nar/gky974> ;
    dcterms:modified "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:bitterdb.site,
