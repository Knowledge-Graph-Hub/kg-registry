kgr:vista a schema1:DataSource ;
    rdfs:label "VISTA Enhancer Browser" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The VISTA Enhancer Browser is a database of experimentally validated human and mouse noncoding fragments with gene enhancer activity as assessed in transgenic mice. Elements are tested in vivo and annotated with their tissue-specific enhancer activity patterns." ;
    dcterms:identifier "vista" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/nar/gkl822> ;
