kgr:mtbs a schema1:DataSource ;
    rdfs:label "Monitoring Trends in Burn Severity" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "Monitoring Trends in Burn Severity (MTBS) is an interagency program that consistently maps the burn severity and perimeter extent of large wildfires across all lands of the United States from 1984 to the present. Fires are mapped where they meet size thresholds of 1,000 acres or greater in the western U.S. and 500 acres or greater in the eastern U.S., covering the continental U.S., Alaska, Hawaii, and Puerto Rico. The program is a joint effort of the U.S. Geological Survey (USGS) and the USDA Forest Service. MTBS data serve as an upstream source for KnowWhereGraph." ;
    dcterms:identifier "mtbs" ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:knowwheregraph.graph,
        kgr:mtbs.direct-download,
        kgr:mtbs.viewer ;
    schema1:name "Monitoring Trends in Burn Severity" ;
    skos:inScheme "environment",
        "general" ;
    adms:status "Active" ;
    foaf:homepage <https://www.mtbs.gov/> .

