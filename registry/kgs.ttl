kgr:noaa-hms a schema1:DataSource ;
    rdfs:label "NOAA Hazard Mapping System Fire and Smoke Product" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The NOAA Hazard Mapping System (HMS) Fire and Smoke Product is a satellite-derived analysis of fire locations and smoke plumes over North America, produced operationally by NOAA's National Environmental Satellite, Data, and Information Service (NESDIS) Office of Satellite and Product Operations (OSPO). Trained analysts integrate automated fire detections from geostationary (GOES) and polar-orbiting satellites with imagery to manually quality-control fire points and to delineate smoke plumes by density. The daily products are distributed as fire point and smoke polygon datasets in Shapefile and KML formats. HMS data are used to monitor wildfire activity and air-quality-relevant smoke transport across the United States, Canada, and Mexico." ;
    dcterms:identifier "noaa-hms" ;
    dcterms:license "U.S. Government Work (public domain)" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:knowwheregraph.graph,
        kgr:noaa-hms.fire-points,
        kgr:noaa-hms.smoke-polygons ;
    schema1:name "NOAA Hazard Mapping System Fire and Smoke Product" ;
    skos:inScheme "environment",
        "public health" ;
    adms:status "Active" ;
    foaf:homepage <https://www.ospo.noaa.gov/products/land/hms.html> .

kgr:noaa-ncei a schema1:DataSource ;
    rdfs:label "NOAA National Centers for Environmental Information" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The NOAA National Centers for Environmental Information (NCEI) is the U.S. government's archive and steward for environmental data, hosting one of the most significant collections of oceanic, atmospheric, climate, weather, and geophysical data on Earth. NCEI preserves and provides access to records including the Storm Events Database, historical hurricane and tropical cyclone tracks (IBTrACS), climate summaries, and a broad range of monitoring products. These data are an upstream source for the KnowWhereGraph project." ;
    dcterms:identifier "noaa-ncei" ;
    dcterms:license "US Government Work (public domain)" ;
    dcterms:modified "2026-09-01T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:knowwheregraph.graph,
        kgr:noaa-ncei.data-search,
        kgr:noaa-ncei.ibtracs,
        kgr:noaa-ncei.storm-events ;
    schema1:name "NOAA National Centers for Environmental Information" ;
    skos:inScheme "environment",
        "general",
        "public health" ;
    adms:status "Active" ;
    foaf:homepage <https://www.ncei.noaa.gov/> .

kgr:noaa-nwm a schema1:DataSource ;
    rdfs:label "NOAA National Water Model (NWM)" ;
    dcterms:created "2026-07-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The NOAA National Water Model (NWM) is an operational hydrologic modeling framework run by the NOAA/NWS Office of Water Prediction that produces continuous, gridded streamflow and hydrologic forecasts for the continental United States. The NWM simulates and forecasts water in streams and rivers on the NHDPlus reach network, delivering analysis-and-assimilation, short-range, medium-range, and long-range forecasts used for flood prediction and water resource applications. The Urban Flooding Open Knowledge Network (UF-OKN) uses NWM streamflow forecasts as the operational, national-scale forecast source that drives its real-time flood-risk information." ;
    dcterms:identifier "noaa-nwm" ;
    dcterms:license "U.S. federal government public domain" ;
    dcterms:modified "2026-07-02T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:noaa-nwm.landing,
        kgr:uf-okn.graph ;
    schema1:name "NOAA National Water Model (NWM)" ;
    skos:inScheme "environment",
        "general",
        "information technology" ;
    adms:status "Active" ;
    foaf:homepage <https://water.noaa.gov/about/nwm> .

kgr:nomen a schema1:Ontology ;
    rdfs:label "NOMEN - A nomenclatural ontology for biological names" ;
    dcterms:created "2025-09-29T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "NOMEN is a nomenclatural ontology for biological names (not concepts).  It encodes the goverened rules of nomenclature." ;
