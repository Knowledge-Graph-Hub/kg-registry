kgr:effas-kpi a schema1:DataModel ;
    rdfs:label "EFFAS KPIs for ESG" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "KPIs for ESG is a standardized framework of Key Performance Indicators for Environmental, Social, and Governance (ESG) reporting, published by EFFAS (the European Federation of Financial Analysts Societies) together with DVFA (the German Society of Investment Professionals). The current \"KPIs for ESG 3.0\" edition defines sector-specific ESG indicators aligned with the Dow Jones Industry Classification Benchmark (ICB), intended for integration of ESG data into corporate performance reporting. It provides the controlled KPI vocabulary used by EmeraldGraph/EmeraldMind." ;
    dcterms:identifier "effas-kpi" ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
