    rdfs:label "Credit" ;
    dcterms:created "2026-02-26T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "CRediT (Contributor Roles Taxonomy) is a controlled vocabulary of contributor roles used to describe how individuals contributed to research and scholarly outputs. It provides a standardized taxonomy for representing contributions such as conceptualization, software, data curation, and writing." ;
