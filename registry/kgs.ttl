kgr:epa-ucmr a schema1:DataSource ;
    rdfs:label "EPA Unregulated Contaminant Monitoring Rule (UCMR)" ;
    dcterms:created "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Unregulated Contaminant Monitoring Rule (UCMR) program directs the US Environmental Protection Agency to collect nationally representative occurrence data for contaminants that are not yet regulated in public drinking water systems. The fifth cycle (UCMR 5) requires monitoring for 29 per- and polyfluoroalkyl substances (PFAS) and lithium, producing sampling results reported by public water systems across the United States. SAWGraph uses UCMR PFAS monitoring results as a primary source for PFAS occurrence in drinking water." ;
    dcterms:identifier "epa-ucmr" ;
    dcterms:license "US federal government public domain" ;
    dcterms:modified "2026-07-01T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:epa-ucmr.landing,
        kgr:sawgraph.graph ;
    schema1:name "EPA Unregulated Contaminant Monitoring Rule (UCMR)" ;
    skos:inScheme "chemistry and biochemistry",
        "environment",
        "public health" ;
    adms:status "Active" ;
    foaf:homepage <https://www.epa.gov/dwucmr> .

kgr:epd a schema1:DataSource ;
    rdfs:label "Eukaryotic Promoter Database" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Eukaryotic Promoter Database (EPD) is an annotated, non-redundant collection of experimentally validated eukaryotic POL II promoters. Its EPDnew components provide high-quality, automatically derived promoter collections for selected organisms, with tools for promoter analysis." ;
    dcterms:identifier "epd" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/nar/gku1111> ;
