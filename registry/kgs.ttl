    foaf:homepage <https://doi.org/10.1109/BIBM47256.2019.8983062> .

kgr:auntbertha a schema1:DataSource ;
    rdfs:label "Aunt Bertha (findhelp)" ;
    dcterms:created "2026-07-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "Aunt Bertha (now operating as findhelp) is a nationwide social care directory of free and reduced-cost health and human services, including food, housing, financial assistance, and other community programs. It provides structured records of service names, descriptions, contact information, locations, languages, cost, availability, hours, and service types." ;
