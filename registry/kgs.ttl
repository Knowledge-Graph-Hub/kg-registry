kgr:biomarker a schema1:KnowledgeGraph ;
    rdfs:label "BiomarkerKB" ;
    dcterms:created "2025-05-29T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "BiomarkerKB is a Common Fund Data Ecosystem (CFDE) sponsored project to develop a knowledgebase that organizes and integrates biomarker data from different public sources, providing researchers with comprehensive, integrated access to biomarker information. This resource also covers the BiomarkerKB Knowledge Graph (BKG), the graph representation of BiomarkerKB data (formerly registered separately as `biomarkerkg`), which is available as an interactive explorer, downloadable node and edge datasets, and OKN/FRINK SPARQL and Triple Pattern Fragments endpoints." ;
    dcterms:identifier "biomarker" ;
    dcterms:isReferencedBy <doi:10.64898/2026.01.26.701395> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-07-15T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:biomarker.api,
        kgr:biomarker.bkg.edges.anatomy,
        kgr:biomarker.bkg.edges.compound,
        kgr:biomarker.bkg.edges.condition,
        kgr:biomarker.bkg.edges.role,
        kgr:biomarker.bkg.edges.variant,
        kgr:biomarker.bkg.explorer,
        kgr:biomarker.bkg.nodes.anatomy,
        kgr:biomarker.bkg.nodes.biomarker,
        kgr:biomarker.bkg.nodes.compound,
        kgr:biomarker.bkg.nodes.condition,
        kgr:biomarker.bkg.nodes.role,
        kgr:biomarker.bkg.nodes.variant,
        kgr:biomarker.datamodel,
        kgr:biomarker.downloads,
        kgr:biomarker.kg,
        kgr:biomarker.obci,
        kgr:biomarker.portal,
        kgr:biomarker.sparql,
        kgr:biomarker.tpf,
        kgr:ubkg.csv,
        kgr:ubkg.neo4j ;
    schema1:name "BiomarkerKB" ;
    doap:repository <https://github.com/clinical-biomarkers> ;
    skos:inScheme "biological systems",
        "biomedical" ;
    adms:status "Active" ;
    foaf:homepage <https://biomarkerkb.org/> .

kgr:biomarkerkg a schema1:KnowledgeGraph ;
    rdfs:label "BiomarkerKB KG" ;
    dcterms:created "2025-05-04T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "BiomarkerKB KG (BKG) has been merged into the BiomarkerKB resource (id `biomarker`) to avoid confusion between the knowledgebase and its knowledge-graph representation, which have near-identical names. Use `biomarker` instead; the BKG explorer, node and edge datasets, and OKN/FRINK SPARQL and Triple Pattern Fragments endpoints are now listed there as products." ;
    dcterms:identifier "biomarkerkg" ;
    dcterms:modified "2026-07-15T00:00:00+00:00"^^xsd:dateTime ;
    schema1:name "BiomarkerKB KG" ;
    doap:repository <https://github.com/MaayanLab/BiomarkerKG> ;
    skos:inScheme "biological systems",
        "biomedical" ;
    adms:status "Inactive" ;
    foaf:homepage <https://biomarkerkb.org/> .

kgr:biomuta a schema1:DataSource ;
    rdfs:label "BioMuta" ;
    dcterms:created "2026-06-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "BioMuta is a cancer-associated single-nucleotide variation resource that integrates mutation records from cancer genomics sources into a unified dataset with protein and disease annotations." ;
    dcterms:identifier "biomuta" ;
    dcterms:isReferencedBy <doi:10.1093/nar/gkx907> ;
