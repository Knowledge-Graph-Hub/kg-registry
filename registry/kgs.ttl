    schema1:name "Entrez" ;
    skos:altLabel "Entrez",
        "NCBI Entrez",
        "NCBIGene" ;
    skos:inScheme "biomedical",
        "literature" ;
    adms:status "Active" ;
    foaf:homepage <https://www.ncbi.nlm.nih.gov/search/> ;
    foaf:maker kgr:ncbi .

