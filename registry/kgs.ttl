        kgr:ubkg.neo4j ;
    schema1:name "Metabolomics Workbench" ;
    skos:altLabel "MW",
        "NMDR",
        "National Metabolomics Data Repository" ;
    skos:inScheme "biomedical",
        "chemistry and biochemistry" ;
    adms:status "Active" ;
    foaf:homepage <https://www.metabolomicsworkbench.org/> .

kgr:myaura a schema1:KnowledgeGraph ;
    rdfs:label "myAURA KG" ;
    dcterms:created "2026-06-12T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "myAURA is a patient-centered epilepsy application and multilayer knowledge graph that integrates heterogeneous epilepsy-relevant resources, including biomedical databases, social media, electronic health records, and literature, to support self-management, care decisions, sparsified graph exploration, and personalized health-library visualization." ;
    dcterms:identifier "myaura" ;
    dcterms:isReferencedBy <doi:10.1093/jamia/ocaf012> ;
    dcterms:license <https://opensource.org/license/mit/> ;
    dcterms:modified "2026-06-22T00:00:00+00:00"^^xsd:dateTime ;
    schema1:about <NCBITaxon:9606> ;
    schema1:hasPart kgr:myaura.graph,
