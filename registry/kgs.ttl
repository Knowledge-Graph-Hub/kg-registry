kgr:rapdb a schema1:DataSource ;
    rdfs:label "Rice Annotation Project Database" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Rice Annotation Project Database (RAP-DB) provides curated genome annotation for the rice species Oryza sativa (Nipponbare), built on the IRGSP-1.0 reference assembly by the Rice Annotation Project together with the National Agriculture and Food Research Organization (NARO). It integrates gene structures, functional annotations, transcript and protein information, and supporting evidence through both an interactive web interface and bulk download files. A central resource is the RAP-MSU locus identifier mapping, which links RAP gene IDs to the corresponding MSU (Michigan State University) Rice Genome Annotation Project locus IDs. RAP-DB serves as the upstream primary source for eco-KG." ;
    dcterms:identifier "rapdb" ;
    dcterms:isReferencedBy <https://www.ncbi.nlm.nih.gov/pubmed/23299411> ;
    dcterms:license "Not specified" ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:eco-kg.graph,
        kgr:rapdb.downloads,
        kgr:rapdb.portal ;
    schema1:name "Rice Annotation Project Database" ;
    skos:inScheme "agriculture",
        "genomics",
        "organisms" ;
    adms:status "Active" ;
    foaf:homepage <https://rapdb.dna.affrc.go.jp/> .

