        kgr:ickg.portal ;
    schema1:name "Immune Cell Knowledge Graph" ;
    doap:repository <https://github.com/KChen-lab/ICKG> ;
    skos:inScheme "biomedical",
        "immunology" ;
    adms:status "Active" ;
    foaf:homepage <https://kchen-lab.github.io/immune-knowledgegraph.github.io/> .

