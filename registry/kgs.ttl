kgr:msigdb a schema1:DataSource ;
    rdfs:label "Molecular Signatures Database" ;
    dcterms:created "2025-10-30T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Molecular Signatures Database (MSigDB) is a comprehensive collection of tens of thousands of annotated gene sets for use with Gene Set Enrichment Analysis (GSEA) software. MSigDB includes curated gene sets from pathway databases, gene ontology annotations, hallmark gene sets, immunologic signatures, regulatory target sets, and cell type-specific signatures derived from single-cell sequencing studies. Available for both human and mouse, with the current public site listing Human MSigDB v2026.1.Hs and Mouse MSigDB v2026.1.Mm." ;
    dcterms:identifier "msigdb" ;
    dcterms:isReferencedBy <PMID:37704782> ;
    dcterms:license <https://www.gsea-msigdb.org/gsea/license_terms_list.jsp> ;
    dcterms:modified "2026-06-02T00:00:00+00:00"^^xsd:dateTime ;
    schema1:about <NCBITaxon:10090>,
        <NCBITaxon:9606> ;
