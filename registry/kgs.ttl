kgr:epa-srs a schema1:DataSource ;
    rdfs:label "EPA Substance Registry Services" ;
    dcterms:created "2026-06-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "EPA Substance Registry Services is the U.S. Environmental Protection Agency's central system for information about substances tracked or regulated by EPA or other sources, including chemicals, biological organisms, and substance lists." ;
    dcterms:identifier "epa-srs" ;
