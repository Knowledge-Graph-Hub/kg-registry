    schema1:name "National Directory of Mental Health Treatment Facilities" ;
    skos:inScheme "clinical",
        "general",
        "public health" ;
    adms:status "Active" ;
    foaf:homepage <https://www.samhsa.gov/data/report/national-directory-mental-health-treatment-facilities> .

