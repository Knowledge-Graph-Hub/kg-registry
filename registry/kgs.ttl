        kgr:kg-enp.workflow ;
    schema1:name "ENPKG" ;
    doap:repository <https://github.com/enpkg/enpkg_full> ;
    skos:altLabel "ENPKG",
        "Experimental Natural Products Knowledge Graph" ;
    skos:inScheme "drug discovery",
        "organisms" ;
    adms:status "Active" ;
    foaf:homepage <https://enpkg.commons-lab.org/> .

kgr:kg-fm a schema1:KnowledgeGraph ;
    rdfs:label "KG-FM" ;
    dcterms:created "2026-06-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "KG-FM is a Neo4j knowledge graph for framework materials, including metal-organic frameworks, covalent-organic frameworks, and hydrogen-bonded organic frameworks. It was constructed with large language model extraction over more than 100,000 Web of Science articles and covers synthesis, properties, applications, publications, and other framework-material relationships." ;
