kgr:atc a schema1:DataSource ;
    rdfs:label "Anatomical Therapeutic Chemical Classification System" ;
    dcterms:created "2026-05-29T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Anatomical Therapeutic Chemical (ATC) classification system groups active medicinal substances by the organ or system on which they act and by therapeutic, pharmacological, and chemical properties. The ATC/DDD methodology is maintained by the WHO Collaborating Centre for Drug Statistics Methodology and endorsed by WHO for drug utilization monitoring and research." ;
    dcterms:identifier "atc" ;
    dcterms:modified "2026-08-06T00:00:00+00:00"^^xsd:dateTime ;
