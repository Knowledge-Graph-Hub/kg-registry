        kgr:emeraldgraph.schema,
        kgr:emeraldgraph.zenodo-archive ;
    schema1:name "EmeraldGraph" ;
    doap:repository <https://github.com/ai4greenwashing/EmeraldMind> ;
    skos:inScheme "environment",
        "information technology" ;
    adms:status "Active" ;
    foaf:homepage <https://github.com/ai4greenwashing/EmeraldMind> .

