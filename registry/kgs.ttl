    doap:repository <https://github.com/BioPack-team/retriever> ;
    skos:altLabel "Retriever" ;
    skos:inScheme "biomedical" ;
    adms:status "Active" ;
    foaf:homepage <https://github.com/BioPack-team/retriever> .

