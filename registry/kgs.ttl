        kgr:pathophenodb.web,
        kgr:spoke-okn.graph,
        kgr:spoke.graph ;
    schema1:identifier "path-pheno-db" ;
    schema1:name "PathoPhenoDB" ;
    doap:repository <https://github.com/bio-ontology-research-group/pathophenodb> ;
    skos:inScheme "biomedical",
        "drug discovery",
        "microbiology",
        "pharmacology" ;
    adms:status "Active" ;
    foaf:homepage <http://patho.phenomebrowser.net/> .

kgr:pathwaycommons a schema1:Aggregator ;
    rdfs:label "Pathway Commons" ;
    dcterms:created "2026-06-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "Pathway Commons is a centralized web resource that aggregates biological pathway and molecular interaction data from pathway, interaction, protein, chemical, and identifier-mapping sources into BioPAX and related network formats. Its PC v14 metadata lists 26 datasource rows, 6,692 pathways, 3,579,336 molecular interactions, and 4,168,535 physical entities." ;
    dcterms:hasVersion "PC v14" ;
    dcterms:identifier "pathwaycommons" ;
    dcterms:isReferencedBy <doi:10.1093/nar/gkq1039>,
