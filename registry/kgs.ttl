kgr:kg-bioportal a schema1:Aggregator ;
    rdfs:label "KG-Bioportal" ;
    dcterms:created "2026-08-06T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "KG-Bioportal transforms the ontologies hosted by BioPortal into KGX node and edge files, so each can be used as a knowledge graph. Transforms run monthly on GitHub Actions and every successful result is published as a release asset, alongside a manifest of per-ontology status and node/edge counts. Over a thousand ontologies are covered; the graph browser is the authoritative listing." ;
    dcterms:identifier "kg-bioportal" ;
    dcterms:license <https://www.bioontology.org/terms/> ;
    dcterms:modified "2026-08-06T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:kg-bioportal.browser,
        kgr:kg-bioportal.code,
        kgr:kg-bioportal.graphs,
        kgr:kg-bioportal.manifest ;
    schema1:name "KG-Bioportal" ;
    doap:repository <https://github.com/ncbo/kg-bioportal> ;
    skos:inScheme "biomedical",
        "clinical",
        "general",
        "information technology" ;
    adms:status "Active" ;
    foaf:homepage <https://ncbo.github.io/kg-bioportal/> .

