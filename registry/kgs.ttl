    schema1:name "SCKAN" ;
    skos:inScheme "anatomy and development",
        "biological systems" ;
    adms:status "Active" ;
    foaf:homepage <https://docs.sparc.science/docs/sckan> .

kgr:scop a schema1:DataSource ;
    rdfs:label "SCOP" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "SCOP (Structural Classification of Proteins) is a classification of protein domains based on their structural and evolutionary relationships. It organizes domains of known three-dimensional structure into a hierarchy that reflects both structural similarity and evolutionary origin." ;
    dcterms:identifier "scop" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/nar/gkz1064> ;
