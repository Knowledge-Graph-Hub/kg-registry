kgr:proteomicsdb a schema1:DataSource ;
    rdfs:label "ProteomicsDB" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "ProteomicsDB is a multi-omics and multi-organism resource for life science research, originally built to expedite the identification of the human proteome and to enable its use across the scientific community. It integrates quantitative proteomics, transcriptomics, and drug-sensitivity data with interactive analysis tools." ;
    dcterms:identifier "proteomicsdb" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/nar/gkx1029> ;
    dcterms:modified "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:genecards.web.interface,
        kgr:proteomicsdb.api,
        kgr:proteomicsdb.site ;
    schema1:name "ProteomicsDB" ;
    skos:inScheme "biomedical",
        "proteomics" ;
    adms:status "Active" ;
    foaf:homepage <https://www.proteomicsdb.org/> .

kgr:proteopedia a schema1:DataSource ;
    rdfs:label "Proteopedia" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "Proteopedia is a collaborative, 3D web-encyclopedia of proteins and other biomolecules. It provides interactive, structure-based pages that bridge the three-dimensional structure and the function of macromolecules, accessible to students, educators, and researchers." ;
    dcterms:identifier "proteopedia" ;
    dcterms:isReferencedBy <https://doi.org/10.1186/gb-2008-9-8-r121> ;
    dcterms:modified "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:genecards.web.interface,
        kgr:proteopedia.site ;
    schema1:name "Proteopedia" ;
    skos:inScheme "chemistry and biochemistry",
        "proteomics" ;
    adms:status "Active" ;
    foaf:homepage <https://proteopedia.org/> .

kgr:proton a schema1:Ontology ;
    rdfs:label "PROTON (PROTo ONtology)" ;
    dcterms:created "2025-12-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "PROTON (PROTo ONtology) is a lightweight upper-level ontology serving as a foundational modeling basis for semantic web applications. It provides a modular framework with approximately 542 entity classes and 183 properties, covering named entities, temporal concepts, quantitative domains, and abstract concepts. Designed for information extraction, semantic annotation, knowledge management, and linked data integration." ;
    dcterms:hasVersion "3.0 Beta" ;
    dcterms:identifier "proton" ;
    dcterms:license <https://creativecommons.org/licenses/by/3.0/> ;
    dcterms:modified "2026-02-20T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:openbiodiv.ontology.ttl,
        kgr:proton.browser,
        kgr:proton.documentation,
        kgr:proton.ontology,
        kgr:proton.top ;
    schema1:name "PROTON (PROTo ONtology)" ;
    doap:repository <https://github.com/Ontotext-AD/proton> ;
    skos:altLabel "PROTON 3.0",
        "PROTON Top",
        "PROTo ONtology" ;
    skos:inScheme "general" ;
    adms:status "Active" ;
    foaf:homepage <https://www.ontotext.com/products/proton/> ;
    foaf:maker kgr:ontotext .

kgr:prov-o a schema1:Ontology ;
    rdfs:label "PROV-O" ;
    dcterms:created "2026-06-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "PROV-O is the W3C PROV Ontology, an OWL2 ontology for representing provenance information and mapping the PROV data model into RDF/OWL." ;
    dcterms:identifier "prov-o" ;
