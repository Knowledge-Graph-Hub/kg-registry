kgr:emind a schema1:DataSource ;
    rdfs:label "eMIND" ;
    dcterms:created "2026-05-20T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "eMIND is a University of Delaware and Protein Information Resource text-mining workflow for extracting protein-coding variant impacts in Alzheimer's disease and related dementias from the biomedical literature." ;
