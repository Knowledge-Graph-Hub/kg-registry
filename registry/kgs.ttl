kgr:hravs a schema1:DataModel ;
    rdfs:label "Human Reference Atlas Value Set (HRAVS)" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "HRAVS (Human Reference Atlas Value Set) is a controlled vocabulary that standardizes the names and definitions of research attributes used across the Human Reference Atlas (HRA) and the broader HuBMAP project. It is distributed as a SKOS-based value set within the HRA Knowledge Graph, providing a consistent, widely accepted set of terms for describing HRA metadata. HRAVS is bundled as an upstream component of the HRA Knowledge Graph (HRA-KG)." ;
    dcterms:identifier "hravs" ;
    dcterms:isReferencedBy <https://doi.org/10.1038/s41597-025-05183-6> ;
