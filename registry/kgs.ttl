        kgr:plncdb.jbrowse,
        kgr:plncdb.portal,
        kgr:rnacentral.api,
        kgr:rnacentral.ftp,
        kgr:rnacentral.portal,
        kgr:rnacentral.public-db ;
    schema1:name "PLncDB" ;
    skos:inScheme "biological systems",
        "genomics" ;
    adms:status "Active" ;
    foaf:homepage <http://plncdb.tobaccodb.org/> .

