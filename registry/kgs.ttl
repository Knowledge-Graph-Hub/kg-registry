kgr:vccf a schema1:Ontology ;
    rdfs:label "Vasculature Common Coordinate Framework" ;
    dcterms:created "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Vasculature Common Coordinate Framework (VCCF) is a vasculature-based common coordinate framework that models the human blood vasculature as a branching coordinate system, using arteries, veins, and capillaries to link anatomical structures and the cells they supply or drain across organs. It is a component of the Human Reference Atlas (HRA) and is realized as the HRA-VCCF, an open, computer-readable description of the adult human blood vasculature covering vessels and their branching connections, associated cell types, and biomarkers. The VCCF underpins the \"blood vasculature\" ASCT+B (Anatomical Structures, Cell Types, plus Biomarkers) table and the HRA's VCCF visualization, supporting single-cell mapping and cross-organ spatial queries." ;
    dcterms:identifier "vccf" ;
    dcterms:isReferencedBy <https://doi.org/10.1038/s41597-023-02018-0> ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:hra-kg.graph.json,
        kgr:hra-kg.graph.nq,
        kgr:hra-kg.graph.nt,
        kgr:hra-kg.graph.ttl,
        kgr:hra-kg.graph.xml,
        kgr:vccf.explorer ;
    schema1:name "Vasculature Common Coordinate Framework" ;
    skos:inScheme "anatomy and development",
        "biological systems",
        "biomedical" ;
    adms:status "Active" ;
    foaf:homepage <https://purl.humanatlas.io/vccf> .

kgr:vdjserver a schema1:DataSource ;
    rdfs:label "VDJServer" ;
    dcterms:created "2026-07-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "VDJServer is a NIAID-supported, cloud-based analysis portal and public data repository for adaptive immune receptor repertoire (AIRR) sequencing data. It provides tools for processing B-cell and T-cell receptor repertoire sequences and hosts an AIRR Data Commons-compliant repository for sharing immune repertoire datasets. VDJServer is one of the NIAID-sponsored repositories whose dataset metadata is harvested and indexed by the NIAID Data Ecosystem Discovery Portal." ;
    dcterms:identifier "vdjserver" ;
    dcterms:modified "2026-07-02T00:00:00+00:00"^^xsd:dateTime ;
    schema1:about <NCBITaxon:9606> ;
    schema1:hasPart kgr:nde.graph,
        kgr:vdjserver.portal ;
    schema1:name "VDJServer" ;
    skos:inScheme "biomedical",
        "genomics",
        "immunology" ;
    adms:status "Active" ;
    foaf:homepage <https://vdjserver.org/> .

kgr:vectology a schema1:Resource ;
    rdfs:label "Vectology" ;
    dcterms:created "2025-09-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "Vectology is a software platform and API for exploring relationships among biomedical variables using sentence embedding models derived from biomedical literature. It converts brief variable descriptions into vector representations enabling similarity search, recommendation, and relational insight without manual ontology annotation." ;
    dcterms:identifier "vectology" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/bioinformatics/btad169> ;
    dcterms:license <https://spdx.org/licenses/GPL-3.0-only> ;
    dcterms:modified "2026-06-18T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:epigraphdb.graph,
        kgr:vectology.api,
        kgr:vectology.docs ;
    schema1:name "Vectology" ;
    doap:repository <https://github.com/MRCIEU/vectology> ;
    skos:inScheme "biomedical",
        "general",
        "genomics" ;
    adms:status "Inactive" ;
    foaf:homepage <http://vectology.mrcieu.ac.uk/> .

