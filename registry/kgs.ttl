        kgr:pharmdb.graph ;
    schema1:name "MATADOR" ;
    skos:inScheme "chemistry and biochemistry",
        "drug discovery",
        "pharmacology" ;
    adms:status "Inactive" ;
    foaf:homepage <http://matador.embl.de/> .

