kgr:achilles a schema1:DataSource ;
    rdfs:label "Project Achilles" ;
    dcterms:created "2025-07-08T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "Project Achilles is a systematic effort aimed at identifying and cataloging gene essentiality across hundreds of genomically characterized cancer cell lines. Achilles uses genome-scale RNAi and CRISPR-Cas9 genetic perturbation reagents to silence or knockout individual genes and identify those genes that affect cell survival." ;
    dcterms:identifier "achilles" ;
    dcterms:isReferencedBy <doi:10.1016/j.cell.2017.06.010> ;
    dcterms:license <https://depmap.org/portal/terms/> ;
    dcterms:modified "2026-05-30T00:00:00+00:00"^^xsd:dateTime ;
    schema1:about <NCBITaxon:9606> ;
    schema1:hasPart kgr:achilles.docs,
        kgr:achilles.downloads,
        kgr:bioteque.embeddings,
        kgr:enrichr-kg.graph,
        kgr:harmonizome.downloads,
        kgr:harmonizome.kg-neo4j ;
    schema1:name "Project Achilles" ;
    skos:inScheme "biomedical",
        "genomics" ;
    adms:status "Active" ;
    foaf:homepage <https://depmap.org/portal/achilles/> ;
    foaf:maker kgr:broad .

kgr:activedriverdb a schema1:DataSource ;
    rdfs:label "ActiveDriverDB" ;
    dcterms:created "2026-06-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "ActiveDriverDB is a human proteo-genomics database for interpreting genetic variation, disease mutations, and cancer driver genes using post-translational modification sites and signaling networks." ;
    dcterms:identifier "activedriverdb" ;
    dcterms:isReferencedBy <doi:10.3389/fcell.2021.626821> ;
    dcterms:modified "2026-06-03T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:activedriverdb.api,
        kgr:activedriverdb.downloads,
        kgr:activedriverdb.portal,
        kgr:ptmd.total_pda ;
    schema1:name "ActiveDriverDB" ;
    doap:repository <https://github.com/reimandlab/ActiveDriverDB> ;
    skos:inScheme "biomedical",
        "genomics",
        "proteomics" ;
    adms:status "Inactive" ;
    foaf:homepage <https://activedriverdb.org/> .

kgr:acukg a schema1:KnowledgeGraph ;
    rdfs:label "AcuKG" ;
    dcterms:created "2026-06-12T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "AcuKG is a comprehensive medical acupuncture knowledge graph that integrates acupuncture textbooks, official sources, clinical trials, biomedical literature, and ontology mappings to represent acupoints, anatomical locations, conditions, therapeutic indications, action targets, and evidence relationships." ;
    dcterms:identifier "acukg" ;
    dcterms:isReferencedBy <doi:10.1093/jamia/ocaf179> ;
    dcterms:modified "2026-06-12T00:00:00+00:00"^^xsd:dateTime ;
    schema1:about <NCBITaxon:9606> ;
    schema1:hasPart kgr:acukg.csv,
        kgr:acukg.json,
        kgr:acukg.rdf ;
    schema1:name "AcuKG" ;
    doap:repository <https://github.com/yimingli99/AcuKG-Knowledge-graph-for-medical-acupuncture> ;
    skos:inScheme "anatomy and development",
        "biomedical",
        "clinical" ;
    adms:status "Active" ;
    foaf:homepage <https://github.com/yimingli99/AcuKG-Knowledge-graph-for-medical-acupuncture> .

kgr:ado a schema1:Ontology ;
    rdfs:label "Alzheimer's Disease Ontology" ;
    dcterms:created "2025-09-29T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "Alzheimer's Disease Ontology is a knowledge-based ontology that encompasses varieties of concepts related to Alzheimer'S Disease, structured by upper level Basic Formal Ontology(BFO). This Ontology is enriched by the interrelated entities that demonstrate the network of the understanding on Alzheimer's disease and can be readily applied for text mining." ;
    dcterms:identifier "ado" ;
    dcterms:isReferencedBy <https://www.ncbi.nlm.nih.gov/pubmed/23830913> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-08-06T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:ado.kg-bioportal,
        kgr:ado.owl ;
    schema1:name "Alzheimer's Disease Ontology" ;
    doap:repository <https://github.com/Fraunhofer-SCAI-Applied-Semantics/ADO> ;
    skos:inScheme "biomedical" ;
    adms:status "Active" ;
    foaf:homepage <https://github.com/Fraunhofer-SCAI-Applied-Semantics/ADO> .

