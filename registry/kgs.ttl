kgr:imgt a schema1:DataSource ;
    rdfs:label "IMGT" ;
    dcterms:created "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "IMGT, the international ImMunoGeneTics information system, is a high-quality integrated knowledge resource specializing in the immunoglobulins (IG), T cell receptors (TR), major histocompatibility complex (MHC), and related proteins of the immune system across vertebrate species. It provides standardized data, tools, and reference directories built on the IMGT-ONTOLOGY." ;
    dcterms:identifier "imgt" ;
    dcterms:isReferencedBy <https://doi.org/10.1093/nar/gku1056> ;
    dcterms:license <https://creativecommons.org/licenses/by-nc-nd/4.0/> ;
    dcterms:modified "2026-06-17T00:00:00+00:00"^^xsd:dateTime ;
    schema1:hasPart kgr:genecards.web.interface,
        kgr:imgt.genedb,
        kgr:imgt.site ;
    schema1:name "IMGT" ;
    skos:inScheme "genomics",
        "immunology",
        "proteomics" ;
    adms:status "Active" ;
    foaf:homepage <https://www.imgt.org/> .

kgr:immport a schema1:DataSource ;
    rdfs:label "ImmPort" ;
    dcterms:created "2026-07-02T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "ImmPort (the Immunology Database and Analysis Portal) is a long-term, sustainable data repository funded by the NIAID Division of Allergy, Immunology, and Transplantation. It archives and freely distributes immunology research data from NIAID-funded clinical and mechanistic studies, including flow cytometry, gene expression, HLA typing, ELISA, and clinical trial data. ImmPort is one of the NIAID-sponsored repositories whose dataset metadata is harvested and indexed by the NIAID Data Ecosystem Discovery Portal." ;
    dcterms:identifier "immport" ;
    dcterms:isReferencedBy <https://www.ncbi.nlm.nih.gov/pubmed/29485622> ;
    dcterms:license <https://docs.immport.org/home/agreement/> ;
    dcterms:modified "2026-07-14T00:00:00+00:00"^^xsd:dateTime ;
    schema1:about <NCBITaxon:9606> ;
    schema1:hasPart kgr:immport.api,
