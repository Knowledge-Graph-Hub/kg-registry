    adms:status "Active" ;
    foaf:homepage <https://unmtid-shinyapps.net/shiny/repodb/> .

kgr:repohub a schema1:DataSource ;
    rdfs:label "Drug Repurposing Hub" ;
    dcterms:created "2025-09-09T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Drug Repurposing Hub is a curated and annotated collection of FDA-approved drugs, clinical trial drugs, and selected pre-clinical tool compounds from the Broad Institute. The collection contains 7,423 unique compounds targeting 2,255 protein targets, with annotations for 775 drug indications and extensive metadata including structures, mechanisms, and therapeutic areas." ;
