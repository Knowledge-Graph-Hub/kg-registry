        kgr:cellphonedb.docs,
        kgr:cellphonedb.package,
        kgr:cellphonedb.web ;
    schema1:name "CellPhoneDB" ;
    doap:repository <https://github.com/ventolab/CellphoneDB> ;
    skos:inScheme "biological systems",
        "immunology",
        "systems biology" ;
    adms:status "Active" ;
    foaf:homepage <https://www.cellphonedb.org/> .

