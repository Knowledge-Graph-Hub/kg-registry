    dcterms:created "2026-07-03T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The npm registry (Node Package Manager) is the public package registry for the JavaScript and Node.js ecosystem, hosting metadata and distributable artifacts for millions of open-source packages." ;
