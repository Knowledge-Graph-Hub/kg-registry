        kgr:fovt.owl ;
    schema1:name "FuTRES Ontology of Vertebrate Traits" ;
    doap:repository <https://github.com/futres/fovt> ;
    skos:inScheme "biological systems",
        "phenotype" ;
    adms:status "Active" ;
    foaf:homepage <https://github.com/futres/fovt> .

