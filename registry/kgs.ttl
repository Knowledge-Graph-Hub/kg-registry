kgr:encode a schema1:DataSource ;
    rdfs:label "ENCODE" ;
    dcterms:created "2026-05-21T00:00:00+00:00"^^xsd:dateTime ;
    dcterms:description "The Encyclopedia of DNA Elements (ENCODE) is an NHGRI-funded international consortium and data resource that catalogs functional elements in the human genome and related model systems using large-scale functional genomics assays, standardized processing pipelines, and openly accessible metadata." ;
    dcterms:identifier "encode" ;
    dcterms:isReferencedBy <doi:10.1038/nature11247> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
